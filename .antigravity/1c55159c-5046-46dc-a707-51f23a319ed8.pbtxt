      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update index.html with matching title, meta tags, and Outfit, Plus Jakarta Sans, and JetBrains Mono fonts\", \"EndLine\":18, \"Instruction\":\"Update index.html title, meta descriptions, and Google Fonts\", \"ReplacementContent\":\"<!doctype html>\\n<html lang=\\\"en\\\" class=\\\"dark\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <title>Nxsha Stream \342\200\224 Unified Cinema & Watch Party Platform</title>\\n    <meta name=\\\"description\\\" content=\\\"Cross-platform adaptive bitrate streaming platform powered by nxsha.space sources, featuring real-time Group & Couple Watch Parties, offline playback vault, social broadcasting, and Gemini AI companions.\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"Nxsha Stream \342\200\224 Unified Cinema & Watch Party Platform\\\" />\\n    <meta property=\\\"og:description\\\" content=\\\"Cross-platform adaptive bitrate streaming platform powered by nxsha.space sources, featuring real-time Group & Couple Watch Parties, offline playback vault, social broadcasting, and Gemini AI companions.\\\" />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin />\\n    <link href=\\\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Outfit:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\" />\\n  </head>\\n  <body class=\\\"bg-slate-950 text-slate-100 antialiased selection:bg-amber-500/30 selection:text-amber-200\\\">\\n    <div id=\\\"root\\\"></div>\\n    <script type=\\\"module\\\" src=\\\"/src/main.tsx\\\"></script>\\n  </body>\\n</html>\", \"StartLine\":1, \"TargetContent\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <title>My Google AI Studio App</title>\\n    <meta name=\\\"description\\\" content=\\\"An application built with Google AI Studio.\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"My Google AI Studio App\\\" />\\n    <meta property=\\\"og:description\\\" content=\\\"An application built with Google AI Studio.\\\" />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n  </head>\\n  <body>\\n    <div id=\\\"root\\\"></div>\\n    <script type=\\\"module\\\" src=\\\"/src/main.tsx\\\"></script>\\n  </body>\\n</html>\", \"TargetFile\":\"/index.html\", \"toolAction\":\"Updating index.html with fonts and metadata\", \"toolSummary\":\"Update index.html\"}"
