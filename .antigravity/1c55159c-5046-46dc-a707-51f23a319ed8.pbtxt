      create_file {
        instruction: "export const BRAND_CONFIG = {\n  name: (typeof import.meta !== \'undefined\' && import.meta.env?.VITE_APP_NAME) || \'CineTogether\',\n  tagline: \'Different places. One screen. Shared moments.\',\n  embedBaseUrl:\n    (typeof import.meta !== \'undefined\' && import.meta.env?.VITE_MEDIA_EMBED_BASE_URL) ||\n    \'https://nxsha.space\',\n};\n\nexport type QualityTier = \'4K UHD\' | \'1080p FHD\' | \'720p HD\' | \'480p Saver\';\n\nexport type MediaCategory = \'movie\' | \'tv\' | \'anime\';\n\nexport type PlatformOrigin =\n  | \'CineTogether Originals\'\n  | \'Nxsha Originals\'\n  | \'Netflix\'\n  | \'Prime Video\'\n  | \'Disney+\'\n  | \'Crunchyroll\'\n  | \'Max\';\n\nexport type RoomMode = \'couple\' | \'group\';\n\nexport type RoomLifecycleState =\n  | \'waiting\'      // Waiting for partner / friends\n  | \'joined\'       // Partner joined\n  | \'selecting\'    // Selecting a movie\n  | \'ready\'        // Ready to watch\n  | \'playing\'      // Playing\n  | \'paused\'       // Paused\n  | \'reconnecting\' // Reconnecting\n  | \'ended\';       // Session ended\n\nexport type RoomThemeId =\n  | \'rose-nebula\'\n  | \'midnight-violet\'\n  | \'starlight-indigo\'\n  | \'velvet-crimson\'\n  | \'aurora-emerald\';\n\nexport type PlayerProviderType = \'synced-studio\' | \'nxsha-embed\';\n\nexport interface MediaItem {\n  id: string;\n  tmdbId: number;\n  title: string;\n  mediaType: MediaCategory;\n  platform: PlatformOrigin;\n  releaseDate: string;\n  year: string;\n  rating: number;\n  durationMinutes: number;\n  seasons?: number;\n  episodes?: number;\n  genres: string[];\n  language: string;\n  description: string;\n  nxshaWatchUrl: string;\n  nxshaEmbedUrl: string;\n  streamUrl: string;\n  hlsUrl?: string;\n  accentColor: string;\n  secondaryColor: string;\n  director: string;\n  cast: string[];\n  isTrending?: boolean;\n  isPopularThisWeek?: boolean;\n  isRecentlyAdded?: boolean;\n  isNewEpisode?: boolean;\n  coupleScore?: number;\n  groupNightScore?: number;\n}\n\nexport interface WatchHistoryEntry {\n  mediaId: string;\n  watchedAt: string;\n  progressSeconds: number;\n  durationSeconds: number;\n  completed: boolean;\n  genres: string[];\n  platform: PlatformOrigin;\n  roomType?: \'solo\' | \'couple\' | \'group\';\n}\n\nexport interface RecommendationResult {\n  item: MediaItem;\n  affinityScore: number;\n  reason: string;\n}\n\nexport interface OfflineDownloadItem {\n  mediaId: string;\n  title: string;\n  mediaType: MediaCategory;\n  quality: QualityTier;\n  sizeMB: number;\n  downloadedAt: string;\n  streamUrl: string;\n  blobAvailable: boolean;\n  progress: number;\n  status: \'downloading\' | \'completed\' | \'paused\';\n  accentColor: string;\n  secondaryColor: string;\n  year: string;\n  durationMinutes: number;\n}\n\nexport interface PartyMember {\n  id: string;\n  name: string;\n  avatarColor?: string;\n  role: \'host\' | \'moderator\' | \'partner\' | \'guest\' | \'member\';\n  isOnline?: boolean;\n  joinedAt: string;\n  mood?: string;\n  micMuted?: boolean;\n  camEnabled?: boolean;\n}\n\nexport interface ChatMessage {\n  id: string;\n  senderId: string;\n  senderName: string;\n  text: string;\n  timestamp: string;\n  videoTimestampSeconds?: number;\n  type: \'chat\' | \'reaction\' | \'system\' | \'heartbeat\';\n}\n\nexport interface RoomVoteItem {\n  id: string;\n  mediaId: string;\n  mediaTitle: string;\n  voterId: string;\n  voterName: string;\n}\n\nexport interface FloatingReaction {\n  id: string;\n  userId: string;\n  userName: string;\n  emoji: string;\n  xPercent: number;\n  createdAt: number;\n}\n\nexport interface WatchRoomSummary {\n  id: string;\n  roomCode: string;\n  roomType: RoomMode;\n  title: string;\n  description: string;\n  hostUserId: string;\n  currentMediaId: string;\n  currentMediaType: MediaCategory;\n  currentSeason: number;\n  currentEpisode: number;\n  isPrivate: boolean;\n  hasPassword?: boolean;\n  maxParticipants: number;\n  collaborativeControls: boolean;\n  roomTheme: RoomThemeId;\n  status: RoomLifecycleState;\n  memberCount: number;\n  createdAt: string;\n}\n\nexport interface PartyPlaybackState {\n  roomId: string;\n  roomCode?: string;\n  roomName: string;\n  mode: RoomMode;\n  mediaId: string;\n  mediaType?: MediaCategory;\n  season?: number;\n  episode?: number;\n  isPlaying: boolean;\n  currentTimeSeconds: number;\n  playbackRate: number;\n  revision: number;\n  updatedAtMs: number;\n  hostId: string;\n  collaborativeControls: boolean;\n  isLocked: boolean;\n  roomTheme: RoomThemeId;\n  lifecycleState: RoomLifecycleState;\n  members: PartyMember[];\n  messages: ChatMessage[];\n  votes: RoomVoteItem[];\n  couplePulseCount: number;\n  couplePartnerNote: string;\n}\n\nexport interface WatchlistEntry {\n  id: string;\n  mediaId: string;\n  mediaTitle: string;\n  mediaType: MediaCategory;\n  posterUrl: string;\n  year: string;\n  rating: number;\n  addedAt: string;\n}\n\nexport interface UserProfile {\n  uid: string;\n  email: string;\n  displayName: string;\n  avatarUrl?: string;\n  preferredTheme: RoomThemeId;\n  isGuest: boolean;\n}\n\nexport interface SocialBroadcastPost {\n  id: string;\n  authorName: string;\n  authorHandle: string;\n  mediaId: string;\n  mediaTitle: string;\n  ClipTimestamp: string;\n  caption: string;\n  platformTarget: \'Community Feed\' | \'X / Twitter\' | \'Discord\' | \'Telegram\' | \'Couple Note\';\n  likes: number;\n  createdAt: string;\n}\n\nexport interface PushNotificationItem {\n  id: string;\n  title: string;\n  body: string;\n  category: \'episode\' | \'trending\' | \'party\' | \'security\';\n  mediaId?: string;\n  createdAt: string;\n  read: boolean;\n}\n\nexport interface SecurityPrivacySettings {\n  e2eHistoryEncryption: boolean;\n  incognitoSession: boolean;\n  drmWatermarkProtection: boolean;\n  strictCoupleRoomPin: string;\n  autoClearCacheHours: number;\n  dnsOverHttpsSource: boolean;\n}\n"
