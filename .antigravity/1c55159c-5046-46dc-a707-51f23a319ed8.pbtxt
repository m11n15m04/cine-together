      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Configure typography variables and scrollbar styling in src/index.css\", \"EndLine\":2, \"Instruction\":\"Add font-family definitions and utility rules in src/index.css\", \"ReplacementContent\":\"@import \\\"tailwindcss\\\";\\n\\n@layer base {\\n  :root {\\n    --font-display: \'Outfit\', -apple-system, BlinkMacSystemFont, sans-serif;\\n    --font-sans: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, sans-serif;\\n    --font-mono: \'JetBrains Mono\', monospace;\\n  }\\n\\n  body {\\n    font-family: var(--font-sans);\\n    letter-spacing: 0.01em;\\n  }\\n\\n  h1, h2, h3, .font-display {\\n    font-family: var(--font-display);\\n    text-wrap: balance;\\n  }\\n\\n  .font-mono, .tabular-nums {\\n    font-family: var(--font-mono);\\n    font-variant-numeric: tabular-nums;\\n  }\\n}\", \"StartLine\":1, \"TargetContent\":\"@import \\\"tailwindcss\\\";\", \"TargetFile\":\"/src/index.css\", \"toolAction\":\"Updating src/index.css with typography rules\", \"toolSummary\":\"Update src/index.css\"}"
