  view_file {
    absolute_path_uri: "file:///src/components/WatchPartyWorkspace.tsx"
    end_line: 510
    content: "import React, { useEffect, useRef, useState } from \'react\';\nimport {\n  Check,\n  Copy,\n  Heart,\n  Lock,\n  MessageSquare,\n  Radio,\n  Send,\n  Sparkles,\n  Users,\n} from \'lucide-react\';\nimport { MediaItem, PartyPlaybackState, QualityTier } from \'../types\';\nimport { evaluateWatchPartySync } from \'../utils/streamEngine\';\nimport { AdaptiveVideoPlayer } from \'./AdaptiveVideoPlayer\';\n\ninterface WatchPartyWorkspaceProps {\n  catalog: MediaItem[];\n  selectedMedia: MediaItem;\n  initialMode: \'group\' | \'couple\';\n  onSelectMedia: (item: MediaItem) => void;\n  onTriggerDownload: (item: MediaItem, quality: QualityTier) => void;\n  onTriggerShare: (item: MediaItem, timestampFormatted: string) => void;\n}\n\nexport const WatchPartyWorkspace: React.FC<WatchPartyWorkspaceProps> = ({\n  catalog,\n  selectedMedia,\n  initialMode,\n  onSelectMedia,\n  onTriggerDownload,\n  onTriggerShare,\n}) => {\n  const [partyMode, setPartyMode] = useState<\'group\' | \'couple\'>(initialMode);\n  const [roomId, setRoomId] = useState<string>(\n    initialMode === \'couple\' ? \'couple-kyoto-77\' : \'nxsha-cinema-1\'\n  );\n  const [memberName, setMemberName] = useState<string>(\'Alex Rivera\');\n  const [chatInput, setChatInput] = useState<string>(\'\');\n  const [coupleNoteInput, setCoupleNoteInput] = useState<string>(\n    \'Friday Date Night \302\267 Kyoto Temple Rain Scene at 08:05\'\n  );\n  const [copiedInvite, setCopiedInvite] = useState<boolean>(false);\n  const [wsConnected, setWsConnected] = useState<boolean>(false);\n\n  const [roomState, setRoomState] = useState<PartyPlaybackState>({\n    roomId: initialMode === \'couple\' ? \'couple-kyoto-77\' : \'nxsha-cinema-1\',\n    roomName:\n      initialMode === \'couple\'\n        ? \'Kyoto Rain \342\200\224 Couple Lounge (2-Seat Encrypted)\'\n        : \'Gotham Premiere \342\200\224 Group Theater\',\n    mode: initialMode,\n    mediaId: selectedMedia.id,\n    isPlaying: false,\n    currentTimeSeconds: 142,\n    playbackRate: 1,\n    updatedAtMs: Date.now(),\n    hostId: \'self\',\n    members: [\n      { id: \'self\', name: \'Alex Rivera\', role: \'host\', joinedAt: \'Now\', mood: \'In Sync\' },\n      {\n        id: \'partner-elena\',\n        name: initialMode === \'couple\' ? \'Elena (Partner)\' : \'Marcus Chen\',\n        role: initialMode === \'couple\' ? \'partner\' : \'guest\',\n        joinedAt: \'2m ago\',\n        mood: \'Locked\',\n      },\n    ],\n    messages: [],\n    couplePulseCount: 14,\n    couplePartnerNote: \'Friday Date Night \302\267 Kyoto Temple Rain Scene at 08:05\',\n  });\n\n  const wsRef = useRef<WebSocket | null>(null);\n  const memberIdRef = useRef<string>(`usr-${Math.random().toString(36).slice(2, 8)}`);\n\n  useEffect(() => {\n    setPartyMode(initialMode);\n    setRoomId(initialMode === \'couple\' ? \'couple-kyoto-77\' : \'nxsha-cinema-1\');\n  }, [initialMode]);\n\n  useEffect(() => {\n    const protocol = window.location.protocol === \'https:\' ? \'wss:\' : \'ws:\';\n    const wsUrl = `${protocol}//${window.location.host}/ws/party`;\n    const ws = new WebSocket(wsUrl);\n    wsRef.current = ws;\n\n    ws.onopen = () => {\n      setWsConnected(true);\n      ws.send(\n        JSON.stringify({\n          type: \'room:join\',\n          roomId,\n          memberId: memberIdRef.current,\n          memberName,\n          mode: partyMode,\n          mediaId: selectedMedia.id,\n        })\n      );\n    };\n\n    ws.onmessage = (event) => {\n      try {\n        const data = JSON.parse(event.data);\n        if (data.type === \'room:state\' && data.room) {\n          const incoming: PartyPlaybackState = data.room;\n          setRoomState(incoming);\n          if (incoming.couplePartnerNote) {\n            setCoupleNoteInput(incoming.couplePartnerNote);\n          }\n          const matchedMedia = catalog.find((c) => c.id === incoming.mediaId);\n          if (matchedMedia && matchedMedia.id !== selectedMedia.id) {\n            onSelectMedia(matchedMedia);\n          }\n        }\n      } catch {\n        // ignore parse errors\n      }\n    };\n\n    ws.onclose = () => {\n      setWsConnected(false);\n    };\n\n    return () => {\n      ws.close();\n    };\n  }, [roomId, partyMode]);\n\n  const handleSwitchMode = (nextMode: \'group\' | \'couple\') => {\n    setPartyMode(nextMode);\n    const targetRoom = nextMode === \'couple\' ? \'couple-kyoto-77\' : \'nxsha-cinema-1\';\n    setRoomId(targetRoom);\n  };\n\n  const handlePlaybackChange = (isPlaying: boolean, currentTimeSeconds: number) => {\n    setRoomState((prev) => ({\n      ...prev,\n      isPlaying,\n      currentTimeSeconds,\n      updatedAtMs: Date.now(),\n    }));\n    if (wsRef.current?.readyState === WebSocket.OPEN) {\n      wsRef.current.send(\n        JSON.stringify({\n          type: \'playback:update\',\n          isPlaying,\n          currentTimeSeconds,\n          mediaId: selectedMedia.id,\n        })\n      );\n    }\n  };\n\n  const handleSendMessage = (e: React.FormEvent) => {\n    e.preventDefault();\n    const trimmed = chatInput.trim();\n    if (!trimmed) return;\n\n    if (wsRef.current?.readyState === WebSocket.OPEN) {\n      wsRef.current.send(\n        JSON.stringify({\n          type: \'chat:send\',\n          senderName: memberName,\n          text: trimmed,\n          videoTimestampSeconds: roomState.currentTimeSeconds,\n          messageType: \'chat\',\n        })\n      );\n    } else {\n      // Optimistic fallback if offline\n      setRoomState((prev) => ({\n        ...prev,\n        messages: [\n          ...prev.messages,\n          {\n            id: `local-${Date.now()}`,\n            senderId: memberIdRef.current,\n            senderName: memberName,\n            text: trimmed,\n            timestamp: \'Now\',\n            videoTimestampSeconds: Math.round(prev.currentTimeSeconds),\n            type: \'chat\',\n          },\n        ],\n      }));\n    }\n    setChatInput(\'\');\n  };\n\n  const handleSendCoupleHeartbeat = () => {\n    if (wsRef.current?.readyState === WebSocket.OPEN) {\n      wsRef.current.send(\n        JSON.stringify({\n          type: \'couple:pulse\',\n          senderName: memberName,\n        })\n      );\n    } else {\n      setRoomState((prev) => ({\n        ...prev,\n        couplePulseCount: prev.couplePulseCount + 1,\n      }));\n    }\n  };\n\n  const handleSaveCoupleNote = () => {\n    if (wsRef.current?.readyState === WebSocket.OPEN) {\n      wsRef.current.send(\n        JSON.stringify({\n          type: \'couple:note\',\n          note: coupleNoteInput,\n        })\n      );\n    }\n  };\n\n  const handleCopyInvite = () => {\n    const url = `${window.location.origin}/?room=${roomId}&mode=${partyMode}`;\n    navigator.clipboard?.writeText(url).catch(() => {});\n    setCopiedInvite(true);\n    setTimeout(() => setCopiedInvite(false), 2500);\n  };\n\n  const syncMetrics = evaluateWatchPartySync(\n    roomState,\n    {\n      isPlaying: roomState.isPlaying,\n      currentTimeSeconds: roomState.currentTimeSeconds,\n      nowMs: Date.now(),\n    },\n    2.0\n  );\n\n  return (\n    <section className=\"space-y-6\" aria-label=\"Watch Party and Couple Lounge\">\n      {/* Mode Selector Header Bar */}\n      <div className=\"flex flex-wrap items-center justify-between gap-4 p-5 bg-slate-900 border border-slate-800 rounded-xl\">\n        <div className=\"space-y-1\">\n          <div className=\"flex items-center gap-3\">\n            <h2 className=\"text-xl font-display font-bold text-white\">\n              {partyMode === \'couple\'\n                ? \'Couple Watch Party \342\200\224 2-Seat Intimate Sync Lounge\'\n                : \'Group Watch Party \342\200\224 Multi-Seat Synchronized Cinema\'}\n            </h2>\n            <span className=\"text-xs font-mono text-slate-400\">\n              Room {roomState.roomId} \302\267 {wsConnected ? \'WebSocket Synced\' : \'Local Sync\'} \302\267 Drift{\' \'}\n              {syncMetrics.driftSeconds.toFixed(2)}s\n            </span>\n          </div>\n          <p className=\"text-sm text-slate-400\">\n            {partyMode === \'couple\'\n              ? \'End-to-end encrypted 2-person private room with synchronized playback, shared heartbeat pulses, and date-night notes.\'\n              : \'Frame-locked group theater up to 16 friends with live timestamped reactions and nxsha.space catalog switching.\'}\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 flex-wrap\">\n          <div\n            className=\"flex items-center p-1 bg-slate-950 border border-slate-800 rounded-lg\"\n            role=\"group\"\n            aria-label=\"Select Watch Party Mode\"\n          >\n            <button\n              type=\"button\"\n              onClick={() => handleSwitchMode(\'group\')}\n              className={`inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                partyMode === \'group\'\n                  ? \'bg-amber-500 text-slate-950 font-semibold\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              <Users className=\"w-3.5 h-3.5\" />\n              <span>Group Watch Party</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => handleSwitchMode(\'couple\')}\n              className={`inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                partyMode === \'couple\'\n                  ? \'bg-pink-500 text-white font-semibold\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              <Heart className=\"w-3.5 h-3.5\" />\n              <span>Couple Watch Party</span>\n            </button>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={handleCopyInvite}\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-100 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n          >\n            {copiedInvite ? (\n              <>\n                <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                <span>Invite Link Copied</span>\n              </>\n            ) : (\n              <>\n                <Copy className=\"w-3.5 h-3.5\" />\n                <span>Copy Room Invite</span>\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Main 2-Column Split: Synchronized Player + Live Room Sidebar */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\">\n        <div className=\"lg:col-span-8 flex flex-col justify-between space-y-4\">\n          <AdaptiveVideoPlayer\n            item={selectedMedia}\n            externalIsPlaying={roomState.isPlaying}\n            externalTimeSeconds={roomState.currentTimeSeconds}\n            onPlaybackChange={handlePlaybackChange}\n            onTriggerDownload={onTriggerDownload}\n            onTriggerShare={onTriggerShare}\n          />\n\n          {/* Quick Catalog Switcher for the Active Room */}\n          <div className=\"p-4 bg-slate-900 border border-slate-800 rounded-xl flex flex-wrap items-center justify-between gap-4\">\n            <div className=\"flex items-center gap-3\">\n              <Radio className=\"w-4 h-4 text-amber-400\" />\n              <div className=\"text-xs text-slate-300\">\n                <span className=\"font-semibold text-white\">Switch Room Feature Film:</span> Select\n                any nxsha.space title to sync everyone immediately\n              </div>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <label htmlFor=\"party-media-select\" className=\"sr-only\">\n                Select Watch Party Title\n              </label>\n              <select\n                id=\"party-media-select\"\n                aria-label=\"Select Watch Party Title\"\n                value={selectedMedia.id}\n                onChange={(e) => {\n                  const found = catalog.find((c) => c.id === e.target.value);\n                  if (found) {\n                    onSelectMedia(found);\n                    handlePlaybackChange(roomState.isPlaying, 0);\n                  }\n                }}\n                className=\"px-3 py-1.5 text-xs bg-slate-950 border border-slate-800 rounded-lg text-slate-100 focus:outline-none focus:border-amber-500\"\n              >\n                {catalog.map((c) => (\n                  <option key={c.id} value={c.id}>\n                    {c.title} ({c.year}) \302\267 \342\230\205 {c.rating}\n                  </option>\n                ))}\n              </select>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Couple / Group Controls + Live Chat */}\n        <div className=\"lg:col-span-4 bg-slate-900 border border-slate-800 rounded-xl p-5 flex flex-col justify-between space-y-4\">\n          {/* Top Room Identity & Couple Controls */}\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n              <div>\n                <h3 className=\"text-sm font-display font-semibold text-white\">\n                  {roomState.roomName}\n                </h3>\n                <p className=\"text-xs text-slate-400 font-mono tabular-nums\">\n                  {roomState.members.length}{\' \'}\n                  {partyMode === \'couple\' ? \'/ 2 Seats Occupied \302\267 E2EE\' : \'Viewers Connected\'}\n                </p>\n              </div>\n              {partyMode === \'couple\' && (\n                <Lock className=\"w-4 h-4 text-pink-400\" aria-label=\"Encrypted Couple Room\" />\n              )}\n            </div>\n\n            {/* Active Seats / Members (Unboxed clean metadata line) */}\n            <div className=\"text-xs text-slate-300 flex flex-wrap items-center gap-x-2 gap-y-1\">\n              <span className=\"text-slate-400\">Active Roster:</span>\n              {roomState.members.map((m, idx) => (\n                <React.Fragment key={m.id}>\n                  {idx > 0 && <span className=\"text-slate-600\">\302\267</span>}\n                  <span className=\"font-medium text-slate-100\">\n                    {m.name} <span className=\"text-slate-400 font-mono\">({m.role})</span>\n                  </span>\n                </React.Fragment>\n              ))}\n            </div>\n\n            {/* Dedicated Couple Watch Party Controls */}\n            {partyMode === \'couple\' && (\n              <div className=\"p-3.5 rounded-xl bg-slate-950 border border-pink-500/30 space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"text-xs text-pink-300 font-medium\">\n                    Couple Sync Pulse \302\267 {roomState.couplePulseCount} Shared Heartbeats\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={handleSendCoupleHeartbeat}\n                    className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-pink-600 hover:bg-pink-500 text-white rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                  >\n                    <Heart className=\"w-3.5 h-3.5 fill-current\" />\n                    <span>Send Heartbeat</span>\n                  </button>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                  <label htmlFor=\"couple-shared-note\" className=\"block text-xs text-slate-400\">\n                    Shared Couple Lounge Pinboard:\n                  </label>\n                  <div className=\"flex items-center gap-2\">\n                    <input\n                      id=\"couple-shared-note\"\n                      type=\"text\"\n                      value={coupleNoteInput}\n                      onChange={(e) => setCoupleNoteInput(e.target.value)}\n                      className=\"flex-1 px-2.5 py-1.5 text-xs bg-slate-900 border border-slate-800 rounded-lg text-slate-200 focus:outline-none focus:border-pink-500\"\n                    />\n                    <button\n                      type=\"button\"\n                      onClick={handleSaveCoupleNote}\n                      className=\"px-2.5 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg whitespace-nowrap shrink-0\"\n                    >\n                      Save Note\n                    </button>\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Live Room Chat Stream */}\n          <div\n            className=\"flex-1 min-h-[220px] max-h-[280px] overflow-y-auto space-y-2.5 pr-1\"\n            aria-label=\"Watch Party Chat Messages\"\n          >\n            {roomState.messages.length === 0 ? (\n              <div className=\"h-full flex flex-col items-center justify-center text-center p-4 text-xs text-slate-500\">\n                <MessageSquare className=\"w-5 h-5 mb-1.5 text-slate-600\" />\n                <p>No messages yet. Say hello or drop a timestamped reaction!</p>\n              </div>\n            ) : (\n              roomState.messages.map((msg) => (\n                <div\n                  key={msg.id}\n                  className={`p-2.5 rounded-lg border text-xs ${\n                    msg.type === \'heartbeat\'\n                      ? \'bg-pink-950/30 border-pink-500/30 text-pink-200\'\n                      : \'bg-slate-950 border-slate-800/90 text-slate-200\'\n                  }`}\n                >\n                  <div className=\"flex items-center justify-between text-[11px] text-slate-400 mb-1 font-mono tabular-nums\">\n                    <span className=\"font-semibold text-slate-300\">{msg.senderName}</span>\n                    <span>\n                      @{Math.floor((msg.videoTimestampSeconds || 0) / 60)}:\n                      {String((msg.videoTimestampSeconds || 0) % 60).padStart(2, \'0\')} \302\267{\' \'}\n                      {msg.timestamp}\n                    </span>\n                  </div>\n                  <p className=\"leading-relaxed\">{msg.text}</p>\n                </div>\n              ))\n            )}\n          </div>\n\n          {/* Chat Input Form */}\n          <form onSubmit={handleSendMessage} className=\"space-y-2 pt-2 border-t border-slate-800\">\n            <div className=\"flex items-center gap-2\">\n              <label htmlFor=\"party-member-name\" className=\"text-xs text-slate-400 shrink-0\">\n                Your Name:\n              </label>\n              <input\n                id=\"party-member-name\"\n                type=\"text\"\n                value={memberName}\n                onChange={(e) => setMemberName(e.target.value)}\n                className=\"flex-1 px-2.5 py-1 text-xs bg-slate-950 border border-slate-800 rounded text-slate-300\"\n              />\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <label htmlFor=\"party-chat-input\" className=\"sr-only\">\n                Type a Watch Party message\n              </label>\n              <input\n                id=\"party-chat-input\"\n                type=\"text\"\n                placeholder={\n                  partyMode === \'couple\'\n                    ? \'Message your partner at this timestamp...\'\n                    : \'Send a timestamped comment to the room...\'\n                }\n                value={chatInput}\n                onChange={(e) => setChatInput(e.target.value)}\n                className=\"flex-1 px-3 py-2 text-xs bg-slate-950 border border-slate-800 rounded-lg text-slate-100 focus:outline-none focus:border-amber-500\"\n              />\n              <button\n                type=\"submit\"\n                aria-label=\"Send chat message\"\n                className=\"inline-flex items-center gap-1.5 px-3.5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-semibold text-xs rounded-lg transition-colors whitespace-nowrap shrink-0\"\n              >\n                <Send className=\"w-3.5 h-3.5\" />\n                <span>Send</span>\n              </button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 511
    num_bytes: 19551
    line_range_bytes: 19551
  }
}
