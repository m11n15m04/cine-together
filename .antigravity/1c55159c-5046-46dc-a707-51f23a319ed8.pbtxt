    command_line: "playwright-cli -s=host resize 1440 900 && \\\nplaywright-cli -s=host run-code \"async page => {\n  await page.waitForSelector(\'[data-testid=\\\"nav-create-watch-party\\\"]\', { timeout: 10000 });\n  const heroTitle = await page.locator(\'h1\').first().textContent();\n  console.log(\'SESSION 1 HERO:\', heroTitle);\n\n  // Navigate to Create Watch Party and create a Couple Room\n  await page.click(\'[data-testid=\\\"nav-create-watch-party\\\"]\');\n  await page.waitForSelector(\'[data-testid=\\\"select-mode-couple\\\"]\');\n  await page.click(\'[data-testid=\\\"launch-watch-party-btn\\\"]\');\n  await page.waitForSelector(\'[data-testid=\\\"room-lifecycle-badge\\\"]\');\n  const createdUrl = page.url();\n  console.log(\'SESSION 1 CREATED ROOM URL:\', createdUrl);\n\n  // Now open shared room LOVE-2026 in Session 1\n  await page.goto(\'http://localhost:3000/?room=LOVE-2026&mode=couple\');\n  await page.waitForSelector(\'[data-testid=\\\"room-lifecycle-badge\\\"]\');\n}\" && \\\nplaywright-cli -s=partner open \"http://localhost:3000/?room=LOVE-2026&mode=couple\" && \\\nplaywright-cli -s=partner resize 1440 900 && \\\nplaywright-cli -s=partner run-code \"async page => {\n  await page.waitForSelector(\'[data-testid=\\\"room-lifecycle-badge\\\"]\', { timeout: 10000 });\n  const lifecycle = await page.locator(\'[data-testid=\\\"room-lifecycle-badge\\\"]\').textContent();\n  console.log(\'SESSION 2 JOINED LIFECYCLE:\', lifecycle);\n\n  // Set Partner Name & send a real-time chat message + heart reaction\n  await page.fill(\'#party-member-name\', \'Sam (Partner 2)\');\n  await page.fill(\'#party-chat-input\', \'Hello from Browser Session 2! Synced and ready \342\235\244\357\270\217\');\n  await page.click(\'button[aria-label=\\\"Send chat message\\\"]\');\n  await page.click(\'button[aria-label=\\\"Send \342\235\244\357\270\217 reaction\\\"]\');\n  await page.waitForTimeout(800);\n}\" && \\\nplaywright-cli -s=host run-code \"async page => {\n  await page.waitForTimeout(600);\n  const bodyText = await page.locator(\'main\').innerText();\n  const hasPartnerMsg = bodyText.includes(\'Hello from Browser Session 2! Synced and ready \342\235\244\357\270\217\');\n  console.log(\'SESSION 1 RECEIVED PARTNER CHAT:\', hasPartnerMsg);\n\n  // Test switching to External Embed (/embed) and verify honest sync notice\n  await page.click(\'button:has-text(\\\"External Embed (/embed)\\\")\');\n  await page.waitForSelector(\'[data-testid=\\\"external-sync-limitation-banner\\\"]\');\n  const notice = await page.locator(\'[data-testid=\\\"external-sync-limitation-banner\\\"]\').innerText();\n  console.log(\'HONEST EXTERNAL EMBED NOTICE:\', notice.slice(0, 90));\n  await page.click(\'button:has-text(\\\"Synced Studio Stream\\\")\');\n}\" && \\\nplaywright-cli -s=host screenshot --filename=/tmp/qa_desktop_couple_room.png && \\\nplaywright-cli -s=partner resize 390 844 && \\\nplaywright-cli -s=partner screenshot --filename=/tmp/qa_mobile_partner_room.png && \\\nplaywright-cli -s=host console error && \\\nplaywright-cli -s=partner console error && \\\nplaywright-cli -s=host close && \\\nplaywright-cli -s=partner close"
