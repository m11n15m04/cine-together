      thinking_signature: "\022\362\027\n\357\027\001i\024}\023\307\332qK.;\031\220\333&\361RG5\222F7\357\225\363\344\252\003QB\203\245\016\f\355\254P\350\004zdST\"F]\375s#\333g\245\342\0268u\n\236\311\343\tt\316\366\r\330\323m\372\366\375\220pEl\373\036\vu\221tF\025\320\276k1\244R0\341`liW\336}\253\030\337\322A\326\342gYw\030\367\025\"\327\255\317\262\302\235\037\257\367)\246\204\376!\310\257\032}y\226\362&\001U~\rp,\"\026\336\316<\240\372\362}n\273\340\252;\274\251\324\017P\372\311\247\363\214\321F\374\235\361u\242\336\0058\324M\223^!\av\370\257\212\311$\370\027\037+\211\bP\264\331\205)a\ay\323t\323\340`\314\330\266\325\333 6\257\033\205I\352r\027\032\335\315\215\'\320-RI\006gw\377\256G\255S\345\331\353\020V\2378l\216k\333R\377\003f\350o)\212\026\225V\333p\020\022w\225N-\275G\003\'\244\2267f\2726\231M\235\274\257\230\275\306e\002\263\262M+\314Lg\2521{\366\330cI\r\271\315B\020\263\331b\361\256}N\314\271\212\017\316\230-\224\325\335\n)\002\320\253\214\377o\242\314(h\307Z\021\330\1774\321\237\270>\242\254\224D\360!K\234\227IV\367\025\225\260bX\233\316\212\307-^I\277\361]\361\216\346\263@\036%\254\222Yb\313+O\375m\333\314\220\370\245\225ru\375\212#yY\000\364\2675\200f\312 /0\376\240\246\360\227\354\327\203I\341\244[CCPJh\362\320#>\016\362f\253p\240\313d.\3376\027X\205\252A\313>\3645+\30420\3629I\v/ \003RH\377\024O\310\3756\317YwV\2366\315\320\213\305EcH\311`\252\252\373\266`\372+\0160\t\f\337#\257\337\344\201\317K\254\370j3\233\346w\223\001c\217b\331\212\202=J\020\3017\326G]\260\\\202\302\t\003CN\364C$@s\321\326\004\364\332@\232\302o\204Y\324\353\306R\212\231h\364\017?f\337%\202\227\341\f\252\300\207\272}\354\244\340+u$m\n\377{n\241 \202\030\345rl\016\026W8=\235\236\250?8#\335\211,r\324\374>\360\211\202\031\352\217\341\234^\245V$M\0321T\203i\264b\023\361]\212\002\0162\273~\310\226Aw\340\216\322\374\342|b\246\346\356\r\300s4\266&\006\312Q\250\263\215\335\223.\224\317\211,*F\270`A$W\345\331\266\267\341\rR}O\356\213\343@_\223\022M\206tt\226F\334\361.=\366\305!\001}hn\000 \332\326\204\344\361\001\365\034\025/\027\021]YY#{\326\302\243\000q\231\017\321\247hp?L\303\367l\372v\b\003\340I\320p\2341\001gR\222\337$eZ\244\266\233;\234\022%\220\323\032\232v\364\326\300\315\314m\033\315\033\363\221\243I\nr\350\311m\311\271\302X\304~O\331\230\f\321Hj\321\306Jv\224\243\255BgM`\275\'k\025\371\320\260\032E\342\336\221\'~\355\206\r&L1\371\bVQ\3130X\372\307\037\204\304\301\303\301\220\366\v%O\201!\211\030+\273{F(CGv\321\001\aK\206E\336G\345\356\r\271S\261\240h!H\257$In\022>&\235l5\333yi\315\330\213\271imn\224\022\261;*\f:\270\306\347&\276\'$z\360\263\0051\335)#&(\000\236\342\006wp\305@s\307\017\240\217\353\350\004vt\311\300\365N\372\264E\261s\002\310\177F\373\261\036\026\221\364\205\371\240q\332\323y\254\313_\000\3053\352n\231\363\361\034\221:a\276z1e)\203\n\017Q\303\2505\304\216:zj\222\277\223\217\340\006V^\327Z\200\331d\001A\177\320\002\307h\253\337\344\004d\330\265Z~\256\205\317r\366\006\274]\337\240\226\335\177u\324\274\210\274\ti\262\307F\317\222\274\373\032\251\270\f\035\t)\300\363k\2604\vq\242\270\035\370\232fH\302H\361\243c+h0\207\022\'\023\322)\324\"\207\246\"sd\240\252\211=\377!\002\274\325?V\332\236\231\304\031+\026\243\316\340e\322w\203L4\020d,\255\346uC\373\271\207\2550\212\025\037Fa\036i\a%pg,\335\247\216L\255\2228\263\336}A#\337\271\276V\222XJ\343t\210\340\302m\036\rX\275=,\307\343\354-\207\204\232\323\023O\261\006XY\270\034([|4\207\023\237H\204\252\370~\"\211\245?~\350\233\210p\235\271\252>3\340\336\262NT\361x\303\361`\277?\373\204\376\311]n\327\221,\370\363\200t\216\237\240h\024W0\352\274\006\275\033\310\037$Q\037\254\274\366\256\247\"\254B\265\277\032\225\373p\205\026\300\300>\351vjW\n\206a~\'\023|\355c\204h]\301\004\205\240e\365\324\t\306c\207\332ff\203Z\262\334]\264\243\243\310\2512\221\366\353\252\"\201\365\f\b\016\314m\337a\355\177\271Q\374\3534R\341\274\001\273\356N\207\251\331\375\267\270\255V~7\306\251$%\244\252\240\037\262\321\363\235\304\210\026\346C8\266\3045i$\366\200@\026\362#\f\267\314\\d\206\r\344\332\220\'\264|~Z\355