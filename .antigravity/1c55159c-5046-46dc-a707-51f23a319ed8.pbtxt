      thinking_signature: "\022\355\b\n\352\b\001i\024}\023X\316M\236~Hi>\244\303\372\372\373\357\232\362\317l5\300\021\226j\252/p\3209\n\376\301\322\246\312YX\305,b\001\211\346\026\351O\361\336\037\314\263Y\357\211\237\274\335\337*\262\200\330pH1:\216\001\030C\3140\\=\372/{b\326e\317&\314\006w\370\f\201\177\334\343\330?\021\022\002\243\235\313\200I1\205S\237=\235\270\r\374&\203\302\002M\257\205.dK[T\223\235\212\345xt|2\2446\351\354\215\237\206\344e\211?\310\224\343\024\264]*\302\260\317g*\203\222\370\003\366\254\004\255\331\324\345\274=\022\307\002k\263q\343\324\023\323{x\273\033\351\270\036\216~|\336\361\016\0279\252~(\324\221X\304\360\211]\322\004\373\243o\261S\'\317\213\030\023\017\026\200\003qg\377\376\3169\374/P\356N\234\346A\016\260\215\216\324\365\350\261@\021\365\001C\207\n\206F|\025\302\224MG\332n#\001#p.\a\177\303@\336\276\005\021\241Zc\214\215\352pb4n&6\335\035NI\aU\236j\322\223\362\202Jt\237Uw(\2561\231\242\236\002{\036\356\n\215EB\352!\330\224\3001Wk\a\263\"\232\021\211\3653\227\330\250\377\330\260\024\240\360\220\343gq\022\263qAz\231c\21712\v\030\031S\033\251\362\327\275\004\033\352\331\026\t\367]\273\003\304\000<JX\262Z\200\274\230\343*\023\312\2248\345K\3538;?]\275\230\302\362\265\203\361c\335+\242\324e\022\304\225\036W\306\272\026\241&R\323\320Yq\327h\323\004*E\327\240\f\255-\206\356=\035\232\315\235\"\323sD\370p\246\303@n\265\000_w^\244\000\017\0353\f\017\365M\316\203\244\335\001\241\336\022\227\356\v\234\225* xa\316\360\017\rLtMDAO%\246\215\363\266\020}\272\034\331\345\336A\254\n\177\037\025\036\351<F\006\f\277\016\021Yku@\344\253\347!\270\354\022\227\024\247}\332RX\031\246\016\302\021\036\352v\305\347\347\301\200D\215\244\236\3579\034\221\245\277\265\376}0,\016\177\313F\002\352N\207\357\307et\177j\032\t\270\030\343\222?l\245\207\271Z\325E\207\224\316W\356\254\253\273\200v\005\005T\354~\333\262\344\312\353c\334\202\220b\304`\346+\302G\333\365\000\241\272\220\355\353<9\221T`\"\316!y\220\230;\005.\030\321\306\266\0004D\312\021\357\374\314V\356V-\34