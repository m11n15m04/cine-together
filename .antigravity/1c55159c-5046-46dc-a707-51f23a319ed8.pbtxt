      thinking_signature: "\022\365\017\n\362\017\001i\024}\023P\3109+\005\310z\373\334\243\357r\036\2606;\031\265\206p\367g\332}\260\240\a\340\233/\321U\273W;\274\"\335\b\220i\227\034\367Z\322\316\206\2402\274_cIb\246\271\354v\367|d\350l\243PF\024\310\3378\221+^\240\232\362t\023+\332\317(\231\347\371\236\317\204b\006\037\226\242\245\257\361\031\272m\002\267\262\302;?0g\266c_\343\323\244X\b8G\205\254}3\215\340\215\324N\220v\213MC7\235\307\377\313f\346\343\377\t\f?\257\214\021]\254\221\021\240K\353]\327\021\2068\263:3K\205Q&^#\302\300\005\f\255\367\200=\001\243\312\337\307\272<^\342\3433 X\3110F[\214\247\034wd\003\027\036[\025\023\303\034\326\207\207\236\272k\037\2632\343&|\au\377\345\004\235^\274Z\263\3436\367\274{\307>\024\243\030\273\365{\004\032\310\221\033\314~\3253b\362\342\330\000\312\352\321\244\366\252\a\232m\200\235\017\315dTc\273>\347f2\377\276\214\a6\315<f\350\346\001\374 q\373D\023\205d\254\207\242\032b\230X\341\222^k\363.\331L:\303\001\316\3547\343\022\223\314\020\001\225\025\332\236\367\3442\267t[ \220$\202Y\234R\340KM\346\021\214KI\251\rD\b\274\330\033\340\2005D\365\367\346\324\201rl\305T#\266\230\0179\214i \315\237i\r\375L\344\002\216SR\364hu\274\245\366\243\031~\003\av#\034\246\177\225\361\023Q\200U\037MmH\267\326XQ\266\374&\231IF&\377\250\027\330\216v\002S\230\331\247p\277\036Q\323\334E\203j^\241\325\320=p\212g\327\215\372r`\243\370\241\314[\351(\311\207\0359C\022\374\0215\023\257gs;\322cV\313Q\006\215\366\257\360\215\200\376D\000/\"\017\245\337\317\272\315r\020\031\037\267w\352\304S\250\b\321D\022\343\245\203\316\260\223\215\3760\250c\271\322y\320U 8\2004$\352N^K|M\0243\267\325\023|(\343\324\v\346\373Ub\273\351\b)\331\r\302h\304E\254G\251\353J~\224B\036\"\322\215\v\017jow\331\377,3\017\372 \0361\336b<@\377\243o\273u\215Q\026Q\020P\337\320w\367\"\222\321\236p\310Z\304\321\275h\324\322p\036\233\003a\036J\302+\tG\025\001\221\226\245\311 \362\330|e\251\240\307\267\312\'\322\205V}\230\003\275\034\n\255\242\204[\225\305\000r\r\214\320}\276\'\214\323\325NZ\343\017\276\332vq\336\377\337/8\352\374^K\245\214V\311\272\321\v\017^X~Jk\363\345\357\216\\\272\260\3217\236!\272\017+\325W\240\b\315\367\231\326\317\263\316v\'\376\255s\324\'],3\314A\350\262\301:\300\366`\016\333P\312\235\210\214V#\307*\241\251Dyz\"!)\210\260\264\317\332\334\3571z\210\017\3750\237\302\000\307RE\242#\351\275@\206\340\320\210\"d.\273$\003\377>\3777\216\331\310\300\311\314\312\303#|\270\267\257\306%\221?yuV\037y\213\001x\233\'\366\273\334\207C\023y\322\260\306\311\314\320\200n<q\345\375h<B\265|({\2478\240\362B\357\305\016\247M\321\n\225-\256&\r\241te\316U|\366\376\006\v\302\320]\006Hu\262\336\262]\273\017\201\221\203\2152\375\022q\0207O\372\213G\306%\375\t$h\232\351\356\000\247\316\214xK\326\211^\0017\223\270F\276\214V\023\001G\303\373\264\327\314\373\331\213k\016\211\273\271R\217\351Ja\302\371\212\244\022{\236:\212m7\230\365}\301\353\315\031\016\316[\213\b3\252\312\215\216\240\201\342\212]\037Q\2357|\024\331\3527\261\376\023<2>\021\254\'s\332\231b<\216\215\245\357\246\231\212\326\347m\221\255!\212\262 X\207\332\247\257\2024(s\001\"\315H\330\310\027\315\3275^.=U\026\251J\000i\230\351\245\361g;xx&{\374\223\315\371\244\205\345d\303\212\035\3136\354BTD\034\222 \204\314\022\3208\241\202Z3I\247tL,\022g\215\314\344\213q\260Y\202\364\251\362\346\307\032\036\316\246\024\327\377t\034I2\202(\353\304\321\032\003\364\024\351\345\250\263k\332\344\021\3113\357\002\350\'+\026`?\362\357\253:$\245\204\016\366\257\0346\017\321\002\'f%!F\tOZt\035\307 c\2341\367&d\271\305\364i7\002\252\212\vx!0OnUa\347\206\310\250\352\374\3059\240\346\277\251\256 I\217!\343=h\271\313w\342\242*\\tU\006`\217\b\224\217\334\214h\202\362@:\265x&\n(b\213vG\\\214\200\341\026H\363T\343\301\330\224\231@\ng_6I:\270\367\233lj:a\373x\245\214g\304\377\330\\d\r\3453\220\346\366<\317\230}\312\274\322ACU\205\342\363\231\036\356\216\225W\231$I\301\347\271\354\t\361\261\352\226\254\201|\237\352N}\b+\270\362\221k\016\025*\214\2273\255D\21678p\331\344\024\205\354\005H\253\254\004\v\026\266\332\334\342yJ\