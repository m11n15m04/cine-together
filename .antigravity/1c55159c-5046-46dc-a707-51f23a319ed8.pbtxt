\" USING btree (\"uid\");\nCREATE INDEX \"room_members_room_idx\" ON \"room_members\" USING btree (\"room_id\");\nCREATE INDEX \"room_members_user_idx\" ON \"room_members\" USING btree (\"user_id\");\nCREATE INDEX \"room_reactions_room_idx\" ON \"room_reactions\" USING btree (\"room_id\");\nCREATE INDEX \"room_votes_room_idx\" ON \"room_votes\" USING btree (\"room_id\");\nCREATE INDEX \"watch_rooms_code_idx\" ON \"watch_rooms\" USING btree (\"room_code\");\nCREATE INDEX \"watch_rooms_host_idx\" ON \"watch_rooms\" USING btree (\"host_user_id\");\nCREATE INDEX \"watch_sessions_user_idx\" ON \"watch_sessions\" USING btree (\"user_id\");\nCREATE INDEX \"watchlist_items_user_idx\" ON \"watchlist_items\" USING btree (\"user_id\");\nCREATE INDEX \"watchlist_items_media_idx\" ON \"watchlist_items\" USING btree (\"media_id\");\nCREATE INDEX \"watchlists_user_idx\" ON \"watchlists\" USING btree (\"user_id\");\n\n[\342\234\223] Changes applied\n"
