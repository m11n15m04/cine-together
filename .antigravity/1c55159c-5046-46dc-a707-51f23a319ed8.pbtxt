      arguments_json: "{\"CodeContent\":\"import { MediaItem, PushNotificationItem, SocialBroadcastPost, WatchHistoryEntry } from \'../types\';\\n\\nexport const INITIAL_CATALOG: MediaItem[] = [\\n  {\\n    id: \'nx-1400940\',\\n    tmdbId: 1400940,\\n    title: \'Clayface\',\\n    mediaType: \'movie\',\\n    platform: \'Nxsha Originals\',\\n    releaseDate: \'Oct 19, 2026\',\\n    year: \'2026\',\\n    rating: 7.5,\\n    durationMinutes: 124,\\n    genres: [\'Sci-Fi\', \'Thriller\', \'Noir\'],\\n    description:\\n      \\\"Matt Hagen\'s meteoric rise from Gotham street kid to Hollywood leading man is tragically cut short when a crime boss leaves him disfigured. Seeking a cutting-edge cellular treatment, he spirals down a path of all-consuming transformation.\\\",\\n    nxshaWatchUrl: \'https://nxsha.space/watch/movie/1400940\',\\n    nxshaEmbedUrl: \'https://nxsha.space/watch/movie/1400940\',\\n    streamUrl: \'/api/media/stream/nx-1400940\',\\n    accentColor: \'#f59e0b\',\\n    secondaryColor: \'#0f172a\',\\n    director: \'Mike Flanagan\',\\n    cast: [\\\"Jack O\'Connell\\\", \'Naomi Scott\', \'Boyd Holbrook\'],\\n    isTrending: true,\\n    coupleScore: 84,\\n  },\\n  {\\n    id: \'nx-969681\',\\n    tmdbId: 969681,\\n    title: \'Spider-Man: Brand New Day\',\\n    mediaType: \'movie\',\\n    platform: \'Disney+\',\\n    releaseDate: \'Jul 29, 2026\',\\n    year: \'2026\',\\n    rating: 8.5,\\n    durationMinutes: 142,\\n    genres: [\'Sci-Fi\', \'Action\', \'Adventure\'],\\n    description:\\n      \\\"Fighting crime full-time in a world that doesn\'t remember him\342\200\224and the pressure of seeing his old friends move on without him\342\200\224sparks a transformation in Peter Parker that may be the only thing able to stop an unseen threat to New York.\\\",\\n    nxshaWatchUrl: \'https://nxsha.space/watch/movie/969681\',\\n    nxshaEmbedUrl: \'https://nxsha.space/watch/movie/969681\',\\n    streamUrl: \'/api/media/stream/nx-969681\',\\n    accentColor: \'#e11d48\',\\n    secondaryColor: \'#1e1b4b\',\\n    director: \'Destin Daniel Cretton\',\\n    cast: [\'Tom Holland\', \'Zendaya\', \'Sadie Sink\'],\\n    isTrending: true,\\n    coupleScore: 95,\\n  },\\n  {\\n    id: \'nx-791523\',\\n    tmdbId: 791523,\\n    title: \'Wildwood\',\\n    mediaType: \'anime\',\\n    platform: \'Crunchyroll\',\\n    releaseDate: \'Oct 19, 2026\',\\n    year: \'2026\',\\n    rating: 8.6,\\n    durationMinutes: 108,\\n    genres: [\'Animation\', \'Fantasy\', \'Adventure\'],\\n    description:\\n      \\\"Prue and her classmate Curtis are drawn into a hidden magical forest filled with enchanted creatures, loyal allies, and formidable adversaries as they embark on a quest to rescue Prue\'s brother.\\\",\\n    nxshaWatchUrl: \'https://nxsha.space/watch/movie/791523\',\\n    nxshaEmbedUrl: \'https://nxsha.space/watch/movie/791523\',\\n    streamUrl: \'/api/media/stream/nx-791523\',\\n    accentColor: \'#10b981\',\\n    secondaryColor: \'#064e3b\',\\n    director: \'Travis Knight\',\\n    cast: [\'Peyton Elizabeth Lee\', \'Jacob Tremblay\', \'Carey Mulligan\'],\\n    isTrending: true,\\n    coupleScore: 98,\\n  },\\n  {\\n    id: \'nx-1384216\',\\n    tmdbId: 1384216,\\n    title: \'The Dog Stars\',\\n    mediaType: \'movie\',\\n    platform: \'Prime Video\',\\n    releaseDate: \'Aug 26, 2026\',\\n    year: \'2026\',\\n    rating: 6.9,\\n    durationMinutes: 131,\\n    genres: [\'Sci-Fi\', \'Drama\', \'Adventure\'],\\n    description:\\n      \'After the world population is ravaged, a pilot lives a quiet existence in a Colorado airplane hangar with his dog. When a mysterious radio transmission breaks the silence while flying his old Cessna, it sparks a perilous journey.\',\\n    nxshaWatchUrl: \'https://nxsha.space/watch/movie/1384216\',\\n    nxshaEmbedUrl: \'https://nxsha.space/watch/movie/1384216\',\\n    streamUrl: \'/api/media/stream/nx-1384216\',\\n    accentColor: \'#0ea5e9\',\\n    secondaryColor: \'#0c4a6e\',\\n    director: \'Ridley Scott\',\\n    cast: [\'Jacob Elordi\', \'Margaret Qualley\', \'Josh Brolin\'],\\n    isTrending: false,\\n    coupleScore: 89,\\n  },\\n  {\\n    id: \'nx-1058424\',\\n    tmdbId: 1058424,\\n    title: \'Hope: Harbor of Shadows\',\\n    mediaType: \'tv\',\\n    platform: \'Netflix\',\\n    releaseDate: \'Jul 15, 2026\',\\n    year: \'2026\',\\n    rating: 8.8,\\n    durationMinutes: 58,\\n    seasons: 2,\\n    episodes: 16,\\n    genres: [\'Mystery\', \'Thriller\', \'Sci-Fi\'],\\n    description:\\n      \'Residents of the isolated harbor town of Hopo Port discover something unknown on the outskirts of their foggy coastline, triggering a desperate investigation into deep-sea acoustic anomalies.\',\\n    nxshaWatchUrl: \'https://nxsha.space/watch/tv/1058424/1/1\',\\n    nxshaEmbedUrl: \'https://nxsha.space/watch/tv/1058424/1/1\',\\n    streamUrl: \'/api/media/stream/nx-1058424\',\\n    accentColor: \'#6366f1\',\\n    secondaryColor: \'#1e1b4b\',\\n    director: \'Na Hong-jin\',\\n    cast: [\'Hwang Jung-min\', \'Zo In-sung\', \'Alicia Vikander\'],\\n    isTrending: true,\\n    isNewEpisode: true,\\n    coupleScore: 91,\\n  },\\n  {\\n    id: \'nx-204988\',\\n    tmdbId: 204988,\\n    title: \'Velvet Echoes in Kyoto\',\\n    mediaType: \'tv\',\\n    platform: \'Netflix\',\\n    releaseDate: \'Sep 12, 2026\',\\n    year: \'2026\',\\n    rating: 9.1,\\n    durationMinutes: 52,\\n    seasons: 1,\\n    episodes: 10,\\n    genres: [\'Romance\', \'Drama\', \'Music\'],\\n    description:\\n      \'Two acoustic restoration engineers working late nights in historic Kyoto temples uncover a decades-old tape recording that bridges their lives across Tokyo and Paris.\',\\n    nxshaWatchUrl: \'https://nxsha.space/watch/tv/204988/1/1\',\\n    nxshaEmbedUrl: \'https://nxsha.space/watch/tv/204988/1/1\',\\n    streamUrl: \'/api/media/stream/nx-204988\',\\n    accentColor: \'#ec4899\',\\n    secondaryColor: \'#3b0764\',\\n    director: \'Celine Song\',\\n    cast: [\'Greta Lee\', \'Teo Yoo\', \'Rinko Kikuchi\'],\\n    isTrending: true,\\n    isNewEpisode: true,\\n    coupleScore: 99,\\n  },\\n  {\\n    id: \'nx-331092\',\\n    tmdbId: 331092,\\n    title: \'Cyberpunk: Edgerunners \342\200\224 Chrome Requiem\',\\n    mediaType: \'anime\',\\n    platform: \'Crunchyroll\',\\n    releaseDate: \'Oct 04, 2026\',\\n    year: \'2026\',\\n    rating: 9.3,\\n    durationMinutes: 26,\\n    seasons: 2,\\n    episodes: 12,\\n    genres: [\'Animation\', \'Sci-Fi\', \'Action\'],\\n    description:\\n      \'A rogue netrunner courier and an orbital trauma-team pilot form an unlikely pact across Night City undergrid sectors to smuggle an uncorrupted neural engram off-world.\',\\n    nxshaWatchUrl: \'https://nxsha.space/watch/tv/331092/1/1\',\\n    nxshaEmbedUrl: \'https://nxsha.space/watch/tv/331092/1/1\',\\n    streamUrl: \'/api/media/stream/nx-331092\',\\n    accentColor: \'#eab308\',\\n    secondaryColor: \'#18181b\',\\n    director: \'Hiroyuki Imaishi\',\\n    cast: [\'Kenn\', \'Aoi Yuuki\', \'Kenjiro Tsuda\'],\\n    isTrending: true,\\n    isNewEpisode: true,\\n    coupleScore: 94,\\n  },\\n  {\\n    id: \'nx-558210\',\\n    tmdbId: 558210,\\n    title: \'Orbital Zero: Lagrange Point\',\\n    mediaType: \'tv\',\\n    platform: \'Max\',\\n    releaseDate: \'Oct 22, 2026\',\\n    year: \'2026\',\\n    rating: 8.7,\\n    durationMinutes: 61,\\n    seasons: 3,\\n    episodes: 24,\\n    genres: [\'Sci-Fi\', \'Thriller\', \'Drama\'],\\n    description:\\n      \'Aboard the Lagrange L2 deep-field array, telemetry analysts detect a repeating chronological echo arriving 48 hours before the events it depicts actually occur on Earth.\',\\n    nxshaWatchUrl: \'https://nxsha.space/watch/tv/558210/1/1\',\\n    nxshaEmbedUrl: \'https://nxsha.space/watch/tv/558210/1/1\',\\n    streamUrl: \'/api/media/stream/nx-558210\',\\n    accentColor: \'#14b8a6\',\\n    secondaryColor: \'#042f2e\',\\n    director: \'Alex Garland\',\\n    cast: [\'Rebecca Ferguson\', \'Dev Patel\', \'Sonoya Mizuno\'],\\n    isTrending: false,\\n    isNewEpisode: true,\\n    coupleScore: 87,\\n  },\\n];\\n\\nexport const INITIAL_WATCH_HISTORY: WatchHistoryEntry[] = [\\n  {\\n    mediaId: \'nx-1400940\',\\n    watchedAt: \'2026-10-25T21:15:00Z\',\\n    progressSeconds: 5820,\\n    durationSeconds: 7440,\\n    completed: false,\\n    genres: [\'Sci-Fi\', \'Thriller\', \'Noir\'],\\n    platform: \'Nxsha Originals\',\\n  },\\n  {\\n    mediaId: \'nx-204988\',\\n    watchedAt: \'2026-10-26T19:40:00Z\',\\n    progressSeconds: 3120,\\n    durationSeconds: 3120,\\n    completed: true,\\n    genres: [\'Romance\', \'Drama\', \'Music\'],\\n    platform: \'Netflix\',\\n  },\\n  {\\n    mediaId: \'nx-331092\',\\n    watchedAt: \'2026-10-26T20:30:00Z\',\\n    progressSeconds: 1560,\\n    durationSeconds: 1560,\\n    completed: true,\\n    genres: [\'Animation\', \'Sci-Fi\', \'Action\'],\\n    platform: \'Crunchyroll\',\\n  },\\n];\\n\\nexport const INITIAL_NOTIFICATIONS: PushNotificationItem[] = [\\n  {\\n    id: \'notif-1\',\\n    title: \'New Episode Live on Nxsha.space\',\\n    body: \'Cyberpunk: Edgerunners \342\200\224 Chrome Requiem S2:E08 is now streaming in 4K HDR10+ ABR.\',\\n    category: \'episode\',\\n    mediaId: \'nx-331092\',\\n    createdAt: \'12m ago\',\\n    read: false,\\n  },\\n  {\\n    id: \'notif-2\',\\n    title: \'Couple Watch Party Ready\',\\n    body: \'Velvet Echoes in Kyoto (99% Couple Match) has been pre-buffered for zero-drift dual sync.\',\\n    category: \'party\',\\n    mediaId: \'nx-204988\',\\n    createdAt: \'45m ago\',\\n    read: false,\\n  },\\n  {\\n    id: \'notif-3\',\\n    title: \'Trending Release Alert\',\\n    body: \'Spider-Man: Brand New Day reached #1 across Nxsha Global Feeds today.\',\\n    category: \'trending\',\\n    mediaId: \'nx-969681\',\\n    createdAt: \'2h ago\',\\n    read: true,\\n  },\\n];\\n\\nexport const INITIAL_SOCIAL_POSTS: SocialBroadcastPost[] = [\\n  {\\n    id: \'post-101\',\\n    authorName: \'Elena Vance\',\\n    authorHandle: \'@elenavance\',\\n    mediaId: \'nx-204988\',\\n    mediaTitle: \'Velvet Echoes in Kyoto\',\\n    ClipTimestamp: \'24:18\',\\n    caption: \'The rain acoustic recording scene in Episode 4 is pure cinema. Hosting a Couple Watch Party tonight!\',\\n    platformTarget: \'Community Feed\',\\n    likes: 48,\\n    createdAt: \'18m ago\',\\n  },\\n  {\\n    id: \'post-102\',\\n    authorName: \'Marcus Chen\',\\n    authorHandle: \'@mchen_cinema\',\\n    mediaId: \'nx-1400940\',\\n    mediaTitle: \'Clayface\',\\n    ClipTimestamp: \'01:12:04\',\\n    caption: \'Streaming in 4K AV1 18.4 Mbps from nxsha.space with zero buffer drop. That practical prosthetic transformation!\',\\n    platformTarget: \'Discord\',\\n    likes: 92,\\n    createdAt: \'1h ago\',\\n  },\\n];\\n\", \"Description\":\"Create initial catalog seeded from nxsha.space titles, watch history, notifications, and social broadcasts\", \"Overwrite\":true, \"TargetFile\":\"/src/data/catalog.ts\", \"toolAction\":\"Creating initial catalog data in src/data/catalog.ts\", \"toolSummary\":\"Create src/data/catalog.ts\"}"
