  code_action {
    action_spec {
      command {
        instruction: "Deduplicate matchedGenres and scale affinityScore in computePersonalizedRecommendations so scores distribute naturally without clamping everything to 99%"
        is_edit: true
        file {
          absolute_uri: "file:///src/utils/streamEngine.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  const scored: RecommendationResult[] = catalog.map((item) => {\n    let rawScore = item.rating * 7; // base 0..70\n    const matchedGenres: string[] = [];\n\n    for (const g of item.genres) {\n      if (genreWeights[g]) {\n        rawScore += Math.min(16, genreWeights[g] * 4.5);\n        matchedGenres.push(g);\n      }\n    }\n\n    if (platformWeights[item.platform]) {\n      rawScore += Math.min(8, platformWeights[item.platform] * 2);\n    }\n\n    if (likedIds.includes(item.id)) {\n      rawScore += 6;\n    }\n\n    // Slightly deprioritize already completed items so new discoveries surface first\n    const alreadyCompleted = history.some((h) => h.mediaId === item.id && h.completed);\n    if (alreadyCompleted) {\n      rawScore -= 12;\n    }\n\n    const affinityScore = Math.max(62, Math.min(99, Math.round(rawScore)));\n\n    let reason = `${affinityScore}% Match \302\267 Top rated in ${item.genres.slice(0, 2).join(\' & \')}`;\n    if (matchedGenres.length > 0) {\n      reason = `${affinityScore}% Match \302\267 Because you watch ${matchedGenres.slice(0, 2).join(\' & \')}`;\n    } else if (topGenres.length > 0) {\n      reason = `${affinityScore}% Match \302\267 Trending across ${item.platform}`;\n    }\n\n    return {\n      item,\n      affinityScore,\n      reason,\n    };\n  });"
          replacement_content: "  const scored: RecommendationResult[] = catalog.map((item, idx) => {\n    let rawScore = item.rating * 6.8; // base ~48..64\n    const matchedGenres: string[] = [];\n\n    for (const g of item.genres) {\n      if (genreWeights[g]) {\n        rawScore += Math.min(11, genreWeights[g] * 2.8);\n        if (!matchedGenres.includes(g)) {\n          matchedGenres.push(g);\n        }\n      }\n    }\n\n    if (platformWeights[item.platform]) {\n      rawScore += Math.min(5, platformWeights[item.platform] * 1.4);\n    }\n\n    if (likedIds.includes(item.id)) {\n      rawScore += 5;\n    }\n\n    // Slightly deprioritize already completed items so new discoveries surface first\n    const alreadyCompleted = history.some((h) => h.mediaId === item.id && h.completed);\n    if (alreadyCompleted) {\n      rawScore -= 9;\n    }\n\n    const affinityScore = Math.max(68, Math.min(99, Math.round(rawScore - (idx % 3))));\n\n    let reason = `${affinityScore}% Match \302\267 Top rated in ${item.genres.slice(0, 2).join(\' & \')}`;\n    if (matchedGenres.length > 0) {\n      reason = `${affinityScore}% Match \302\267 Because you watch ${matchedGenres.slice(0, 2).join(\' & \')}`;\n    } else if (topGenres.length > 0) {\n      reason = `${affinityScore}% Match \302\267 Trending across ${item.platform}`;\n    }\n\n    return {\n      item,\n      affinityScore,\n      reason,\n    };\n  });"
          start_line: 121
          end_line: 168
        }
      }
    }
