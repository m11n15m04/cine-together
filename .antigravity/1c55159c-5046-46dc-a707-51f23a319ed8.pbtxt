      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add revision validation, drift classification, Nxsha embed URL builder, and room code generator to src/utils/streamEngine.ts\", \"EndLine\":324, \"Instruction\":\"Append buildNxshaEmbedUrl, shouldAcceptSyncRevision, classifyPlaybackDrift, and generateRoomCode to src/utils/streamEngine.ts\", \"ReplacementContent\":\"  const hex1 = (h1 >>> 0).toString(16).padStart(8, \'0\');\\n  const hex2 = (h2 >>> 0).toString(16).padStart(8, \'0\');\\n  return `NX-${hex1.toUpperCase().slice(0, 4)}-${hex2.toUpperCase().slice(0, 4)}-E2EE`;\\n}\\n\\n/**\\n * Builds the canonical Nxsha embed URL for movies (/embed/movie/{id})\\n * and episodic TV/Anime (/embed/tv/{id}/{season}/{episode}).\\n */\\nexport function buildNxshaEmbedUrl(\\n  baseUrl: string,\\n  mediaType: \'movie\' | \'tv\' | \'anime\',\\n  tmdbId: number,\\n  season = 1,\\n  episode = 1\\n): string {\\n  const cleanBase = (baseUrl || \'https://nxsha.space\').replace(/\\\\/+$/, \'\');\\n  if (mediaType === \'movie\') {\\n    return `${cleanBase}/embed/movie/${tmdbId}`;\\n  }\\n  const safeSeason = Math.max(1, Math.floor(season || 1));\\n  const safeEpisode = Math.max(1, Math.floor(episode || 1));\\n  return `${cleanBase}/embed/tv/${tmdbId}/${safeSeason}/${safeEpisode}`;\\n}\\n\\n/**\\n * Stale-event rejection: returns true only when an incoming server revision\\n * is greater than or equal to the client\'s last applied revision.\\n */\\nexport function shouldAcceptSyncRevision(\\n  currentRevision: number,\\n  incomingRevision: number\\n): boolean {\\n  if (!Number.isFinite(incomingRevision)) return false;\\n  return incomingRevision >= currentRevision;\\n}\\n\\n/**\\n * Classifies playback drift into \'in-sync\' (<= 0.4s), \'soft-adjust\' (0.4s..2.0s),\\n * or \'hard-seek\' (> 2.0s) for smooth room playback reconciliation.\\n */\\nexport function classifyPlaybackDrift(\\n  driftSeconds: number\\n): \'in-sync\' | \'soft-adjust\' | \'hard-seek\' {\\n  const abs = Math.abs(driftSeconds);\\n  if (abs <= 0.4) return \'in-sync\';\\n  if (abs <= 2.0) return \'soft-adjust\';\\n  return \'hard-seek\';\\n}\\n\\n/**\\n * Generates a human-friendly room code for Couple Cinema or Group Cinema.\\n */\\nexport function generateRoomCode(mode: \'couple\' | \'group\', seedSuffix?: string): string {\\n  const prefix = mode === \'couple\' ? \'LOVE\' : \'CLUB\';\\n  const chars = \'ABCDEFGHJKLMNPQRSTUVWXYZ23456789\';\\n  if (seedSuffix && seedSuffix.trim().length >= 4) {\\n    return `${prefix}-${seedSuffix.trim().toUpperCase().slice(0, 4)}`;\\n  }\\n  let code = \'\';\\n  for (let i = 0; i < 4; i++) {\\n    code += chars.charAt(Math.floor(Math.random() * chars.length));\\n  }\\n  return `${prefix}-${code}`;\\n}\\n\", \"StartLine\":320, \"TargetContent\":\"  const hex1 = (h1 >>> 0).toString(16).padStart(8, \'0\');\\n  const hex2 = (h2 >>> 0).toString(16).padStart(8, \'0\');\\n  return `NX-${hex1.toUpperCase().slice(0, 4)}-${hex2.toUpperCase().slice(0, 4)}-E2EE`;\\n}\", \"TargetFile\":\"/src/utils/streamEngine.ts\", \"toolAction\":\"Adding sync and embed helpers to streamEngine.ts\", \"toolSummary\":\"Update src/utils/streamEngine.ts\"}"
