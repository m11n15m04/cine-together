  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useRef, useState } from \'react\';\nimport {\n  Check,\n  Download,\n  ExternalLink,\n  Maximize2,\n  Pause,\n  Play,\n  Radio,\n  Share2,\n  Sparkles,\n  Subtitles,\n  Volume2,\n  VolumeX,\n  Wifi,\n} from \'lucide-react\';\nimport { MediaItem, QualityTier } from \'../types\';\nimport { calculateAdaptiveBitrate } from \'../utils/streamEngine\';\n\ninterface AdaptiveVideoPlayerProps {\n  item: MediaItem;\n  isOfflineMode?: boolean;\n  externalIsPlaying?: boolean;\n  externalTimeSeconds?: number;\n  onPlaybackChange?: (isPlaying: boolean, currentTimeSeconds: number) => void;\n  onTriggerDownload: (item: MediaItem, quality: QualityTier) => void;\n  onTriggerShare: (item: MediaItem, timestampFormatted: string) => void;\n  onClose?: () => void;\n  compact?: boolean;\n}\n\nconst SUBTITLE_CUES = [\n  \'Signal locked from Nxsha global edge relay...\',\n  \'Notice the shadow geometry across the wet concrete.\',\n  \'Telemetry confirms chronological drift of 48 hours.\',\n  \'If we sever the acoustic link now, there is no return.\',\n  \'Hold position\342\200\224frequency resonance approaching peak.\',\n];\n\nexport const AdaptiveVideoPlayer: React.FC<AdaptiveVideoPlayerProps> = ({\n  item,\n  isOfflineMode = false,\n  externalIsPlaying,\n  externalTimeSeconds,\n  onPlaybackChange,\n  onTriggerDownload,\n  onTriggerShare,\n  onClose,\n  compact = false,\n}) => {\n  const [sourceMode, setSourceMode] = useState<\'abr-direct\' | \'nxsha-embed\'>(\'abr-direct\');\n  const [isPlaying, setIsPlaying] = useState<boolean>(externalIsPlaying ?? true);\n  const [currentTime, setCurrentTime] = useState<number>(externalTimeSeconds ?? 142);\n  const [isMuted, setIsMuted] = useState<boolean>(true);\n  const [subtitlesOn, setSubtitlesOn] = useState<boolean>(true);\n  const [qualityPref, setQualityPref] = useState<QualityTier | \'auto\'>(\'auto\');\n  const [bandwidthMbps, setBandwidthMbps] = useState<number>(24.6);\n  const [isDataSaver, setIsDataSaver] = useState<boolean>(false);\n  const [quickRecapText, setQuickRecapText] = useState<string | null>(null);\n  const [recapLoading, setRecapLoading] = useState<boolean>(false);\n  const [downloadTriggered, setDownloadTriggered] = useState<boolean>(false);\n\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n  const isPlayingRef = useRef(isPlaying);\n  const currentTimeRef = useRef(currentTime);\n  isPlayingRef.current = isPlaying;\n  currentTimeRef.current = currentTime;\n\n  const totalDurationSeconds = (item.durationMinutes || 110) * 60;\n  const abrDecision = calculateAdaptiveBitrate(bandwidthMbps, qualityPref, isDataSaver);\n\n  // Sync with external Watch Party state if provided\n  useEffect(() => {\n    if (typeof externalIsPlaying === \'boolean\' && externalIsPlaying !== isPlaying) {\n      setIsPlaying(externalIsPlaying);\n    }\n  }, [externalIsPlaying]);\n\n  useEffect(() => {\n    if (\n      typeof externalTimeSeconds === \'number\' &&\n      Math.abs(externalTimeSeconds - currentTime) > 2.5\n    ) {\n      setCurrentTime(externalTimeSeconds);\n    }\n  }, [externalTimeSeconds]);\n\n  // Advance playback timer at 1Hz for UI scrubber without 60Hz React state updates\n  useEffect(() => {\n    if (!isPlaying) return;\n    const interval = window.setInterval(() => {\n      setCurrentTime((prev) => {\n        const next = prev + 1 >= totalDurationSeconds ? 0 : prev + 1;\n        return next;\n      });\n    }, 1000);\n    return () => window.clearInterval(interval);\n  }, [isPlaying, totalDurationSeconds]);\n\n  // Render deterministic cinema frame on canvas\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas || sourceMode !== \'abr-direct\') return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    let animId = 0;\n    let frameCount = 0;\n\n    const drawFrame = () => {\n      frameCount += isPlayingRef.current ? 1 : 0;\n      const t = currentTimeRef.current + (frameCount % 60) / 60;\n      const w = canvas.width;\n      const h = canvas.height;\n\n      // Deep anamorphic background gradient\n      const bgGrad = ctx.createLinearGradient(0, 0, w, h);\n      bgGrad.addColorStop(0, item.secondaryColor || \'#0f172a\');\n      bgGrad.addColorStop(0.55, \'#090d16\');\n      bgGrad.addColorStop(1, \'#020617\');\n      ctx.fillStyle = bgGrad;\n      ctx.fillRect(0, 0, w, h);\n\n      // Moving atmospheric light sweep\n      const sweepX = (w * 0.5) + Math.sin(t * 0.45) * (w * 0.24);\n      const sweepY = (h * 0.44) + Math.cos(t * 0.3) * (h * 0.12);\n      const glow = ctx.createRadialGradient(sweepX, sweepY, 10, sweepX, sweepY, w * 0.45);\n      glow.addColorStop(0, `${item.accentColor}66`);\n      glow.addColorStop(0.5, `${item.accentColor}1f`);\n      glow.addColorStop(1, \'transparent\');\n      ctx.fillStyle = glow;\n      ctx.fillRect(0, 0, w, h);\n\n      // Horizon & parallax architectural silhouette bars\n      ctx.strokeStyle = `${item.accentColor}44`;\n      ctx.lineWidth = 1.5;\n      const horizonY = h * 0.68;\n      ctx.beginPath();\n      ctx.moveTo(0, horizonY);\n      ctx.lineTo(w, horizonY);\n      ctx.stroke();\n\n      // Dynamic acoustic/telemetry waveform bars along the horizon\n      const barCount = 42;\n      const barWidth = w / (barCount * 1.8);\n      ctx.fillStyle = `${item.accentColor}88`;\n      for (let i = 0; i < barCount; i++) {\n        const x = w * 0.12 + i * (barWidth * 1.6);\n        const wave =\n          Math.abs(Math.sin(t * 1.8 + i * 0.35) * Math.cos(t * 0.7 - i * 0.2)) * (h * 0.16) + 4;\n        ctx.fillRect(x, horizonY - wave, barWidth, wave);\n      }\n\n      // Anamorphic letterbox bars\n      ctx.fillStyle = \'#020617\';\n      ctx.fillRect(0, 0, w, h * 0.08);\n      ctx.fillRect(0, h * 0.92, w, h * 0.08);\n\n      // Top-left subtle stream source stamp\n      ctx.fillStyle = \'rgba(226, 232, 240, 0.65)\';\n      ctx.font = \'12px \"JetBrains Mono\", monospace\';\n      ctx.fillText(\n        `NXSHA.SPACE DIRECT STREAM \302\267 ${abrDecision.selectedQuality} (${abrDecision.bitrateMbps} Mbps) \302\267 ${abrDecision.codec}`,\n        24,\n        h * 0.055\n      );\n\n      if (isPlayingRef.current) {\n        animId = window.requestAnimationFrame(drawFrame);\n      }\n    };\n\n    drawFrame();\n    return () => {\n      if (animId) window.cancelAnimationFrame(animId);\n    };\n  }, [item, sourceMode, isPlaying, abrDecision.selectedQuality, abrDecision.bitrateMbps, abrDecision.codec]);\n\n  const formatTime = (secs: number) => {\n    const s = Math.max(0, Math.floor(secs));\n    const hrs = Math.floor(s / 3600);\n    const mins = Math.floor((s % 3600) / 60);\n    const rem = s % 60;\n    if (hrs > 0) {\n      return `${hrs}:${String(mins).padStart(2, \'0\')}:${String(rem).padStart(2, \'0\')}`;\n    }\n    return `${String(mins).padStart(2, \'0\')}:${String(rem).padStart(2, \'0\')}`;\n  };\n\n  const handleTogglePlay = () => {\n    const next = !isPlaying;\n    setIsPlaying(next);\n    onPlaybackChange?.(next, currentTime);\n  };\n\n  const handleSeek = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const nextTime = Number(e.target.value);\n    setCurrentTime(nextTime);\n    onPlaybackChange?.(isPlaying, nextTime);\n  };\n\n  const handleRequestQuickRecap = async () => {\n    setRecapLoading(true);\n    try {\n      const resp = await fetch(\'/api/gemini/quick-recap\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          title: item.title,\n          timestampSeconds: currentTime,\n        }),\n      });\n      const data = await resp.json();\n      setQuickRecapText(data.recap || \'Scene context synthesized.\');\n    } catch {\n      setQuickRecapText(\n        `Up to ${formatTime(currentTime)} in ${item.title}: Key narrative tensions converge without spoilers for the upcoming sequence.`\n      );\n    } finally {\n      setRecapLoading(false);\n    }\n  };\n\n  const activeSubtitle =\n    SUBTITLE_CUES[Math.floor(currentTime / 6) % SUBTITLE_CUES.length];\n\n  return (\n    <div className=\"bg-slate-950 border border-slate-800 rounded-xl overflow-hidden text-slate-100\">\n      {/* Top Player Source & Telemetry Bar */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 px-4 py-3 bg-slate-900/90 border-b border-slate-800\">\n        <div className=\"flex items-center gap-3 min-w-0\">\n          <span className=\"font-display font-semibold text-base text-white truncate\">\n            {item.title}\n          </span>\n          <span className=\"text-xs text-slate-400 font-mono tabular-nums whitespace-nowrap\">\n            {item.year} \302\267 {abrDecision.selectedQuality} \302\267 {abrDecision.bitrateMbps} Mbps\n          </span>\n          {isOfflineMode && (\n            <span className=\"text-xs text-amber-400 font-mono whitespace-nowrap\">\n              \302\267 Playing from Offline Vault\n            </span>\n          )}\n        </div>\n\n        <div className=\"flex items-center gap-2 flex-wrap\">\n          {/* Source Engine Switcher: Direct ABR vs Nxsha.space Cloud Embed */}\n          <div\n            className=\"flex items-center bg-slate-950 p-1 rounded-lg border border-slate-800\"\n            role=\"group\"\n            aria-label=\"Video Stream Source Engine\"\n          >\n            <button\n              type=\"button\"\n              onClick={() => setSourceMode(\'abr-direct\')}\n              className={`px-2.5 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                sourceMode === \'abr-direct\'\n                  ? \'bg-amber-500 text-slate-950 font-semibold\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              Adaptive Stream\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setSourceMode(\'nxsha-embed\')}\n              disabled={isOfflineMode}\n              className={`px-2.5 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                sourceMode === \'nxsha-embed\'\n                  ? \'bg-amber-500 text-slate-950 font-semibold\'\n                  : \'text-slate-400 hover:text-white disabled:opacity-40\'\n              }`}\n            >\n              nxsha.space Cloud\n            </button>\n          </div>\n\n          <a\n            href={item.nxshaWatchUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium text-slate-300 hover:text-white bg-slate-800/80 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n          >\n            <span>Source Link</span>\n            <ExternalLink className=\"w-3.5 h-3.5\" />\n          </a>\n\n          {onClose && (\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-3 py-1.5 text-xs font-medium text-slate-300 hover:text-white bg-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n            >\n              Close Theater\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Main Video Viewport */}\n      <div\n        className={`relative bg-black w-full ${\n          compact ? \'aspect-video max-h-[360px]\' : \'aspect-video max-h-[520px]\'\n        } flex items-center justify-center overflow-hidden`}\n      >\n        {sourceMode === \'abr-direct\' ? (\n          <>\n            <canvas\n              ref={canvasRef}\n              width={960}\n              height={540}\n              data-testid=\"adaptive-cinema-canvas\"\n              onClick={handleTogglePlay}\n              className=\"w-full h-full object-cover cursor-pointer\"\n            />\n\n            {/* Center Play/Pause Overlay Indicator when paused */}\n            {!isPlaying && (\n              <button\n                type=\"button\"\n                onClick={handleTogglePlay}\n                aria-label=\"Resume Playback\"\n                className=\"absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-[2px] transition-opacity\"\n              >\n                <div className=\"w-16 h-16 rounded-full bg-amber-500 text-slate-950 flex items-center justify-center shadow-lg\">\n                  <Play className=\"w-7 h-7 fill-current ml-0.5\" />\n                </div>\n              </button>\n            )}\n\n            {/* Subtitle Track Overlay */}\n            {subtitlesOn && (\n              <div className=\"absolute bottom-12 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded bg-slate-950/85 text-slate-100 text-sm font-medium text-center max-w-xl pointer-events-none border border-slate-800/80\">\n                {activeSubtitle}\n              </div>\n            )}\n          </>\n        ) : (\n          <div className=\"w-full h-full relative flex flex-col\">\n            <iframe\n              src={item.nxshaEmbedUrl}\n              title={`${item.title} on nxsha.space`}\n              className=\"w-full h-full border-0 bg-slate-950\"\n              sandbox=\"allow-scripts allow-same-origin allow-forms\"\n            />\n            <div className=\"absolute bottom-3 right-3 bg-slate-950/90 border border-slate-800 px-3 py-1.5 rounded-lg text-xs text-slate-300 flex items-center gap-2\">\n              <span>Connected to {item.nxshaWatchUrl}</span>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Scrubber & Transport Controls */}\n      <div className=\"p-4 bg-slate-900/95 border-t border-slate-800 space-y-3\">\n        <div className=\"flex items-center gap-3\">\n          <span className=\"text-xs font-mono tabular-nums text-slate-300 w-14\">\n            {formatTime(currentTime)}\n          </span>\n          <input\n            type=\"range\"\n            aria-label=\"Seek video timeline\"\n            min={0}\n            max={totalDurationSeconds}\n            value={currentTime}\n            onChange={handleSeek}\n            className=\"flex-1 h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-500\"\n          />\n          <span className=\"text-xs font-mono tabular-nums text-slate-400 w-14 text-right\">\n            {formatTime(totalDurationSeconds)}\n          </span>\n        </div>\n\n        {/* Primary Transport + Adaptive Bitrate + Action Controls */}\n        <div className=\"flex flex-wrap items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-2\">\n            <button\n              type=\"button\"\n              onClick={handleTogglePlay}\n              aria-label={isPlaying ? \'Pause video\' : \'Play video\'}\n              className=\"inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-semibold text-xs rounded-lg transition-colors whitespace-nowrap shrink-0\"\n            >\n              {isPlaying ? <Pause className=\"w-4 h-4\" /> : <Play className=\"w-4 h-4\" />}\n              <span>{isPlaying ? \'Pause\' : \'Play\'}</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setIsMuted(!isMuted)}\n              aria-label={isMuted ? \'Unmute audio\' : \'Mute audio\'}\n              className=\"p-2 text-slate-300 hover:text-white bg-slate-800/80 hover:bg-slate-800 rounded-lg transition-colors\"\n            >\n              {isMuted ? <VolumeX className=\"w-4 h-4\" /> : <Volume2 className=\"w-4 h-4\" />}\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setSubtitlesOn(!subtitlesOn)}\n              aria-label=\"Toggle Subtitles\"\n              className={`p-2 rounded-lg transition-colors ${\n                subtitlesOn\n                  ? \'bg-amber-500/20 text-amber-300 border border-amber-500/40\'\n                  : \'bg-slate-800/80 text-slate-400 hover:text-white\'\n              }`}\n            >\n              <Subtitles className=\"w-4 h-4\" />\n            </button>\n\n            {/* Instant AI Scene Recap (gemini-3.1-flash-lite) */}\n            <button\n              type=\"button\"\n              onClick={handleRequestQuickRecap}\n              disabled={recapLoading}\n              className=\"inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n              <span>{recapLoading ? \'Synthesizing...\' : \'Instant Scene Recap\'}</span>\n            </button>\n          </div>\n\n          {/* Adaptive Bitrate Quality & Bandwidth Selector */}\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <div className=\"flex items-center gap-1.5 bg-slate-950 px-2.5 py-1.5 rounded-lg border border-slate-800\">\n              <Wifi className=\"w-3.5 h-3.5 text-amber-400\" />\n              <label htmlFor={`abr-select-${item.id}`} className=\"sr-only\">\n                Adaptive Bitrate Quality\n              </label>\n              <select\n                id={`abr-select-${item.id}`}\n                aria-label=\"Adaptive Bitrate Quality\"\n                value={qualityPref}\n                onChange={(e) => setQualityPref(e.target.value as QualityTier | \'auto\')}\n                className=\"bg-transparent text-xs font-mono text-slate-200 focus:outline-none cursor-pointer\"\n              >\n                <option value=\"auto\" className=\"bg-slate-900\">\n                  Auto ABR ({abrDecision.selectedQuality})\n                </option>\n                <option value=\"4K UHD\" className=\"bg-slate-900\">\n                  4K UHD \302\267 18.4 Mbps\n                </option>\n                <option value=\"1080p FHD\" className=\"bg-slate-900\">\n                  1080p FHD \302\267 6.8 Mbps\n                </option>\n                <option value=\"720p HD\" className=\"bg-slate-900\">\n                  720p HD \302\267 3.2 Mbps\n                </option>\n                <option value=\"480p Saver\" className=\"bg-slate-900\">\n                  480p Saver \302\267 1.1 Mbps\n                </option>\n              </select>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={() => setIsDataSaver(!isDataSaver)}\n              className={`px-2.5 py-1.5 text-xs font-medium rounded-lg border transition-colors whitespace-nowrap shrink-0 ${\n                isDataSaver\n                  ? \'bg-emerald-500/20 border-emerald-500/40 text-emerald-300\'\n                  : \'bg-slate-950 border-slate-800 text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              {isDataSaver ? \'Data Saver: ON\' : \'Data Saver: OFF\'}\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => {\n                onTriggerDownload(item, abrDecision.selectedQuality);\n                setDownloadTriggered(true);\n                setTimeout(() => setDownloadTriggered(false), 2500);\n              }}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n            >\n              {downloadTriggered ? (\n                <>\n                  <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                  <span>Saved to Offline Vault</span>\n                </>\n              ) : (\n                <>\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span>Download ({abrDecision.selectedQuality})</span>\n                </>\n              )}\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => onTriggerShare(item, formatTime(currentTime))}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n            >\n              <Share2 className=\"w-3.5 h-3.5\" />\n              <span>Share Clip</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Network Bandwidth Simulator Bar for ABR Testing */}\n        <div className=\"flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-slate-800/80 text-xs text-slate-400\">\n          <div className=\"flex items-center gap-3\">\n            <Radio className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span className=\"font-mono tabular-nums\">{abrDecision.reason}</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span className=\"font-mono tabular-nums\">\n              Buffer Health: {abrDecision.bufferHealthSeconds}s\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <label htmlFor={`bw-slider-${item.id}`} className=\"text-xs text-slate-400\">\n              Simulate Link Speed:\n            </label>\n            <input\n              id={`bw-slider-${item.id}`}\n              type=\"range\"\n              min={1}\n              max={40}\n              step={0.5}\n              value={bandwidthMbps}\n              onChange={(e) => setBandwidthMbps(Number(e.target.value))}\n              className=\"w-24 h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-500\"\n            />\n            <span className=\"font-mono tabular-nums text-slate-300 w-16 text-right\">\n              {bandwidthMbps.toFixed(1)} Mbps\n            </span>\n          </div>\n        </div>\n\n        {/* Instant Scene Recap Callout (gemini-3.1-flash-lite) */}\n        {quickRecapText && (\n          <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 flex items-start justify-between gap-3\">\n            <div className=\"space-y-1\">\n              <div className=\"text-xs font-mono text-amber-400\">\n                Instant Scene Context \302\267 gemini-3.1-flash-lite \302\267 Timestamp {formatTime(currentTime)}\n              </div>\n              <p className=\"text-xs text-slate-300 leading-relaxed\">{quickRecapText}</p>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => setQuickRecapText(null)}\n              className=\"text-xs text-slate-400 hover:text-white shrink-0\"\n            >\n              Dismiss\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/AdaptiveVideoPlayer.tsx"
        }
        overwrite: true
      }
    }
