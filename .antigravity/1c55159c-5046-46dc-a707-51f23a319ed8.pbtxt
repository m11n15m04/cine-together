    tool_calls {
      id: "call_2206697"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"export type QualityTier = \'4K UHD\' | \'1080p FHD\' | \'720p HD\' | \'480p Saver\';\\n\\nexport type MediaCategory = \'movie\' | \'tv\' | \'anime\';\\n\\nexport type PlatformOrigin = \'Nxsha Originals\' | \'Netflix\' | \'Prime Video\' | \'Disney+\' | \'Crunchyroll\' | \'Max\';\\n\\nexport interface MediaItem {\\n  id: string;\\n  tmdbId: number;\\n  title: string;\\n  mediaType: MediaCategory;\\n  platform: PlatformOrigin;\\n  releaseDate: string;\\n  year: string;\\n  rating: number;\\n  durationMinutes: number;\\n  seasons?: number;\\n  episodes?: number;\\n  genres: string[];\\n  description: string;\\n  nxshaWatchUrl: string;\\n  nxshaEmbedUrl: string;\\n  streamUrl: string;\\n  hlsUrl?: string;\\n  accentColor: string;\\n  secondaryColor: string;\\n  director: string;\\n  cast: string[];\\n  isTrending?: boolean;\\n  isNewEpisode?: boolean;\\n  coupleScore?: number;\\n}\\n\\nexport interface WatchHistoryEntry {\\n  mediaId: string;\\n  watchedAt: string;\\n  progressSeconds: number;\\n  durationSeconds: number;\\n  completed: boolean;\\n  genres: string[];\\n  platform: PlatformOrigin;\\n}\\n\\nexport interface RecommendationResult {\\n  item: MediaItem;\\n  affinityScore: number;\\n  reason: string;\\n}\\n\\nexport interface OfflineDownloadItem {\\n  mediaId: string;\\n  title: string;\\n  mediaType: MediaCategory;\\n  quality: QualityTier;\\n  sizeMB: number;\\n  downloadedAt: string;\\n  streamUrl: string;\\n  blobAvailable: boolean;\\n  progress: number;\\n  status: \'downloading\' | \'completed\' | \'paused\';\\n  accentColor: string;\\n  secondaryColor: string;\\n  year: string;\\n  durationMinutes: number;\\n}\\n\\nexport interface PartyMember {\\n  id: string;\\n  name: string;\\n  role: \'host\' | \'partner\' | \'guest\';\\n  joinedAt: string;\\n  mood?: string;\\n}\\n\\nexport interface ChatMessage {\\n  id: string;\\n  senderId: string;\\n  senderName: string;\\n  text: string;\\n  timestamp: string;\\n  videoTimestampSeconds?: number;\\n  type: \'chat\' | \'reaction\' | \'system\' | \'heartbeat\';\\n}\\n\\nexport interface PartyPlaybackState {\\n  roomId: string;\\n  roomName: string;\\n  mode: \'group\' | \'couple\';\\n  mediaId: string;\\n  isPlaying: boolean;\\n  currentTimeSeconds: number;\\n  playbackRate: number;\\n  updatedAtMs: number;\\n  hostId: string;\\n  members: PartyMember[];\\n  messages: ChatMessage[];\\n  couplePulseCount: number;\\n  couplePartnerNote: string;\\n}\\n\\nexport interface SocialBroadcastPost {\\n  id: string;\\n  authorName: string;\\n  authorHandle: string;\\n  mediaId: string;\\n  mediaTitle: string;\\n  ClipTimestamp: string;\\n  caption: string;\\n  platformTarget: \'Community Feed\' | \'X / Twitter\' | \'Discord\' | \'Telegram\' | \'Couple Note\';\\n  likes: number;\\n  createdAt: string;\\n}\\n\\nexport interface PushNotificationItem {\\n  id: string;\\n  title: string;\\n  body: string;\\n  category: \'episode\' | \'trending\' | \'party\' | \'security\';\\n  mediaId?: string;\\n  createdAt: string;\\n  read: boolean;\\n}\\n\\nexport interface SecurityPrivacySettings {\\n  e2eHistoryEncryption: boolean;\\n  incognitoSession: boolean;\\n  drmWatermarkProtection: boolean;\\n  strictCoupleRoomPin: string;\\n  autoClearCacheHours: number;\\n  dnsOverHttpsSource: boolean;\\n}\\n\", \"Description\":\"Create TypeScript interfaces for media items, adaptive bitrate engine, watch parties, offline downloads, social sharing, and security settings\", \"Overwrite\":true, \"TargetFile\":\"/src/types.ts\", \"toolAction\":\"Creating TypeScript interfaces in src/types.ts\", \"toolSummary\":\"Create src/types.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2206973"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  MediaItem,\\n  OfflineDownloadItem,\\n  PartyPlaybackState,\\n  QualityTier,\\n  RecommendationResult,\\n  WatchHistoryEntry,\\n} from \'../types\';\\n\\nexport interface AdaptiveBitrateDecision {\\n  selectedQuality: QualityTier;\\n  bitrateMbps: number;\\n  codec: string;\\n  resolutionLabel: string;\\n  bufferHealthSeconds: number;\\n  reason: string;\\n}\\n\\n/**\\n * Pure adaptive bitrate calculation based on measured network bandwidth,\\n * user quality preference, and data saver mode.\\n */\\nexport function calculateAdaptiveBitrate(\\n  bandwidthMbps: number,\\n  manualQuality: QualityTier | \'auto\',\\n  isDataSaver: boolean\\n): AdaptiveBitrateDecision {\\n  const safeBandwidth = Math.max(0.5, Number.isFinite(bandwidthMbps) ? bandwidthMbps : 10);\\n\\n  if (isDataSaver) {\\n    return {\\n      selectedQuality: \'480p Saver\',\\n      bitrateMbps: 1.1,\\n      codec: \'AV1 Main 8-bit\',\\n      resolutionLabel: \'854\303\227480 \302\267 30fps\',\\n      bufferHealthSeconds: Math.min(45, Math.round(safeBandwidth * 6)),\\n      reason: \'Data Saver active \302\267 Capped at 1.1 Mbps\',\\n    };\\n  }\\n\\n  if (manualQuality !== \'auto\') {\\n    const manualSpecs: Record<QualityTier, { mbps: number; codec: string; res: string }> = {\\n      \'4K UHD\': { mbps: 18.4, codec: \'AV1 Main 10 HDR10+\', res: \'3840\303\2272160 \302\267 60fps\' },\\n      \'1080p FHD\': { mbps: 6.8, codec: \'HEVC H.265 10-bit\', res: \'1920\303\2271080 \302\267 60fps\' },\\n      \'720p HD\': { mbps: 3.2, codec: \'AVC H.264 High\', res: \'1280\303\227720 \302\267 30fps\' },\\n      \'480p Saver\': { mbps: 1.1, codec: \'AV1 Main 8-bit\', res: \'854\303\227480 \302\267 30fps\' },\\n    };\\n    const spec = manualSpecs[manualQuality];\\n    const ratio = safeBandwidth / spec.mbps;\\n    return {\\n      selectedQuality: manualQuality,\\n      bitrateMbps: spec.mbps,\\n      codec: spec.codec,\\n      resolutionLabel: spec.res,\\n      bufferHealthSeconds: Math.max(4, Math.min(40, Math.round(ratio * 14))),\\n      reason: `Locked to ${manualQuality} (${spec.mbps} Mbps)`,\\n    };\\n  }\\n\\n  if (safeBandwidth >= 20) {\\n    return {\\n      selectedQuality: \'4K UHD\',\\n      bitrateMbps: 18.4,\\n      codec: \'AV1 Main 10 HDR10+\',\\n      resolutionLabel: \'3840\303\2272160 \302\267 60fps\',\\n      bufferHealthSeconds: 32,\\n      reason: `Auto ABR \302\267 Optimal for ${safeBandwidth.toFixed(1)} Mbps link`,\\n    };\\n  }\\n  if (safeBandwidth >= 8) {\\n    return {\\n      selectedQuality: \'1080p FHD\',\\n      bitrateMbps: 6.8,\\n      codec: \'HEVC H.265 10-bit\',\\n      resolutionLabel: \'1920\303\2271080 \302\267 60fps\',\\n      bufferHealthSeconds: 24,\\n      reason: `Auto ABR \302\267 Optimal for ${safeBandwidth.toFixed(1)} Mbps link`,\\n    };\\n  }\\n  if (safeBandwidth >= 3.5) {\\n    return {\\n      selectedQuality: \'720p HD\',\\n      bitrateMbps: 3.2,\\n      codec: \'AVC H.264 High\',\\n      resolutionLabel: \'1280\303\227720 \302\267 30fps\',\\n      bufferHealthSeconds: 18,\\n      reason: `Auto ABR \302\267 Balanced for ${safeBandwidth.toFixed(1)} Mbps link`,\\n    };\\n  }\\n  return {\\n    selectedQuality: \'480p Saver\',\\n    bitrateMbps: 1.1,\\n    codec: \'AV1 Main 8-bit\',\\n    resolutionLabel: \'854\303\227480 \302\267 30fps\',\\n    bufferHealthSeconds: 14,\\n    reason: `Auto ABR \302\267 Low-bandwidth protection (${safeBandwidth.toFixed(1)} Mbps)`,\\n  };\\n}\\n\\n/**\\n * Pure recommendation engine scoring catalog items against user watch history and likes.\\n */\\nexport function computePersonalizedRecommendations(\\n  catalog: MediaItem[],\\n  history: WatchHistoryEntry[],\\n  likedIds: string[]\\n): RecommendationResult[] {\\n  if (!catalog.length) return [];\\n\\n  const genreWeights: Record<string, number> = {};\\n  const platformWeights: Record<string, number> = {};\\n  const watchedMediaIds = new Set<string>();\\n\\n  for (const entry of history) {\\n    watchedMediaIds.add(entry.mediaId);\\n    const completionRatio =\\n      entry.durationSeconds > 0\\n        ? Math.min(1, entry.progressSeconds / entry.durationSeconds)\\n        : 0.5;\\n    const weightBoost = 1 + completionRatio * 2 + (entry.completed ? 1 : 0);\\n\\n    for (const genre of entry.genres) {\\n      genreWeights[genre] = (genreWeights[genre] || 0) + weightBoost;\\n    }\\n    platformWeights[entry.platform] = (platformWeights[entry.platform] || 0) + weightBoost * 0.6;\\n  }\\n\\n  for (const likedId of likedIds) {\\n    const likedItem = catalog.find((c) => c.id === likedId);\\n    if (likedItem) {\\n      for (const g of likedItem.genres) {\\n        genreWeights[g] = (genreWeights[g] || 0) + 3.5;\\n      }\\n    }\\n  }\\n\\n  const topGenres = Object.entries(genreWeights)\\n    .sort((a, b) => b[1] - a[1])\\n    .map(([g]) => g);\\n\\n  const scored: RecommendationResult[] = catalog.map((item) => {\\n    let rawScore = item.rating * 7; // base 0..70\\n    const matchedGenres: string[] = [];\\n\\n    for (const g of item.genres) {\\n      if (genreWeights[g]) {\\n        rawScore += Math.min(16, genreWeights[g] * 4.5);\\n        matchedGenres.push(g);\\n      }\\n    }\\n\\n    if (platformWeights[item.platform]) {\\n      rawScore += Math.min(8, platformWeights[item.platform] * 2);\\n    }\\n\\n    if (likedIds.includes(item.id)) {\\n      rawScore += 6;\\n    }\\n\\n    // Slightly deprioritize already completed items so new discoveries surface first\\n    const alreadyCompleted = history.some((h) => h.mediaId === item.id && h.completed);\\n    if (alreadyCompleted) {\\n      rawScore -= 12;\\n    }\\n\\n    const affinityScore = Math.max(62, Math.min(99, Math.round(rawScore)));\\n\\n    let reason = `${affinityScore}% Match \302\267 Top rated in ${item.genres.slice(0, 2).join(\' & \')}`;\\n    if (matchedGenres.length > 0) {\\n      reason = `${affinityScore}% Match \302\267 Because you watch ${matchedGenres.slice(0, 2).join(\' & \')}`;\\n    } else if (topGenres.length > 0) {\\n      reason = `${affinityScore}% Match \302\267 Trending across ${item.platform}`;\\n    }\\n\\n    return {\\n      item,\\n      affinityScore,\\n      reason,\\n    };\\n  });\\n\\n  return scored.sort((a, b) => b.affinityScore - a.affinityScore);\\n}\\n\\nexport interface SyncReconciliation {\\n  shouldSeek: boolean;\\n  targetTimeSeconds: number;\\n  shouldTogglePlay: boolean;\\n  targetIsPlaying: boolean;\\n  driftSeconds: number;\\n}\\n\\n/**\\n * Evaluates whether a Watch Party or Couple Watch Party client needs to seek or toggle playback\\n * to stay locked with the authoritative room state.\\n */\\nexport function evaluateWatchPartySync(\\n  authoritativeState: Pick<PartyPlaybackState, \'isPlaying\' | \'currentTimeSeconds\' | \'playbackRate\' | \'updatedAtMs\'>,\\n  localState: { isPlaying: boolean; currentTimeSeconds: number; nowMs: number },\\n  maxDriftSeconds = 2.0\\n): SyncReconciliation {\\n  const elapsedSeconds = authoritativeState.isPlaying\\n    ? Math.max(0, (localState.nowMs - authoritativeState.updatedAtMs) / 1000) *\\n      (authoritativeState.playbackRate || 1)\\n    : 0;\\n\\n  const expectedServerTime = Math.max(0, authoritativeState.currentTimeSeconds + elapsedSeconds);\\n  const driftSeconds = Math.abs(expectedServerTime - localState.currentTimeSeconds);\\n\\n  return {\\n    shouldSeek: driftSeconds > maxDriftSeconds,\\n    targetTimeSeconds: Number(expectedServerTime.toFixed(2)),\\n    shouldTogglePlay: authoritativeState.isPlaying !== localState.isPlaying,\\n    targetIsPlaying: authoritativeState.isPlaying,\\n    driftSeconds: Number(driftSeconds.toFixed(2)),\\n  };\\n}\\n\\n/**\\n * Comprehensive multi-field catalog search and filtering.\\n */\\nexport function filterAndSearchCatalog(\\n  catalog: MediaItem[],\\n  query: string,\\n  category: \'all\' | \'movie\' | \'tv\' | \'anime\',\\n  platform: string,\\n  minRating = 0\\n): MediaItem[] {\\n  const normalizedQuery = query.trim().toLowerCase();\\n\\n  return catalog.filter((item) => {\\n    if (category !== \'all\' && item.mediaType !== category) {\\n      return false;\\n    }\\n    if (platform !== \'All Platforms\' && item.platform !== platform) {\\n      return false;\\n    }\\n    if (item.rating < minRating) {\\n      return false;\\n    }\\n    if (!normalizedQuery) {\\n      return true;\\n    }\\n    const haystack = [\\n      item.title,\\n      item.description,\\n      item.year,\\n      item.platform,\\n      item.director,\\n      ...item.genres,\\n      ...item.cast,\\n    ]\\n      .join(\' \')\\n      .toLowerCase();\\n\\n    return haystack.includes(normalizedQuery);\\n  });\\n}\\n\\n/**\\n * Calculates offline storage footprint and quota metrics.\\n */\\nexport function formatStorageQuota(\\n  downloads: OfflineDownloadItem[],\\n  maxQuotaMB = 8192\\n): {\\n  usedMB: number;\\n  availableMB: number;\\n  percentUsed: number;\\n  completedCount: number;\\n} {\\n  const usedMB = downloads.reduce((acc, item) => {\\n    const progressFactor = item.status === \'completed\' ? 1 : Math.max(0.1, item.progress / 100);\\n    return acc + item.sizeMB * progressFactor;\\n  }, 0);\\n\\n  const roundedUsed = Math.round(usedMB);\\n  const availableMB = Math.max(0, maxQuotaMB - roundedUsed);\\n  const percentUsed = Math.min(100, Math.round((roundedUsed / maxQuotaMB) * 100));\\n  const completedCount = downloads.filter((d) => d.status === \'completed\').length;\\n\\n  return {\\n    usedMB: roundedUsed,\\n    availableMB,\\n    percentUsed,\\n    completedCount,\\n  };\\n}\\n\\n/**\\n * Estimates download size in MB based on duration and quality tier.\\n */\\nexport function estimateOfflineSizeMB(durationMinutes: number, quality: QualityTier): number {\\n  const minutes = Math.max(10, durationMinutes || 95);\\n  const mbPerMinute: Record<QualityTier, number> = {\\n    \'4K UHD\': 28,\\n    \'1080p FHD\': 11,\\n    \'720p HD\': 5.5,\\n    \'480p Saver\': 2.2,\\n  };\\n  return Math.round(minutes * mbPerMinute[quality]);\\n}\\n\\n/**\\n * Generates a deterministic SHA-like privacy fingerprint for E2E encrypted watch history & couple room security.\\n */\\nexport function generatePrivacyFingerprint(userId: string, pin: string): string {\\n  const seed = `${userId.trim() || \'nxsha-anon\'}::${pin.trim() || \'0000\'}::AES256GCM`;\\n  let h1 = 0xdeadbeef ^ seed.length;\\n  let h2 = 0x41c6ce57 ^ seed.length;\\n  for (let i = 0; i < seed.length; i++) {\\n    const ch = seed.charCodeAt(i);\\n    h1 = Math.imul(h1 ^ ch, 2654435761);\\n    h2 = Math.imul(h2 ^ ch, 1597334677);\\n  }\\n  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);\\n  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);\\n  const hex1 = (h1 >>> 0).toString(16).padStart(8, \'0\');\\n  const hex2 = (h2 >>> 0).toString(16).padStart(8, \'0\');\\n  return `NX-${hex1.toUpperCase().slice(0, 4)}-${hex2.toUpperCase().slice(0, 4)}-E2EE`;\\n}\\n\", \"Description\":\"Create pure streaming, recommendation, watch party sync, and offline storage logic in src/utils/streamEngine.ts\", \"Overwrite\":true, \"TargetFile\":\"/src/utils/streamEngine.ts\", \"toolAction\":\"Creating pure streaming logic in src/utils/streamEngine.ts\", \"toolSummary\":\"Create src/utils/streamEngine.ts\"}"
      original_name: "write_to_file"
