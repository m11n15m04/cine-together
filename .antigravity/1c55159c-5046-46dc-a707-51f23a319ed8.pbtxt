  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 1099
    content: "import React, { useEffect, useMemo, useState } from \'react\';\nimport {\n  Bell,\n  Check,\n  Compass,\n  Download,\n  ExternalLink,\n  Film,\n  Heart,\n  HardDrive,\n  Moon,\n  Play,\n  Search,\n  Share2,\n  ShieldCheck,\n  Sparkles,\n  Sun,\n  Users,\n} from \'lucide-react\';\nimport {\n  INITIAL_CATALOG,\n  INITIAL_NOTIFICATIONS,\n  INITIAL_SOCIAL_POSTS,\n  INITIAL_WATCH_HISTORY,\n} from \'./data/catalog\';\nimport {\n  MediaItem,\n  OfflineDownloadItem,\n  PushNotificationItem,\n  QualityTier,\n  SecurityPrivacySettings,\n  SocialBroadcastPost,\n  WatchHistoryEntry,\n} from \'./types\';\nimport {\n  computePersonalizedRecommendations,\n  estimateOfflineSizeMB,\n  filterAndSearchCatalog,\n} from \'./utils/streamEngine\';\nimport { MediaPoster } from \'./components/MediaPoster\';\nimport { AdaptiveVideoPlayer } from \'./components/AdaptiveVideoPlayer\';\nimport { WatchPartyWorkspace } from \'./components/WatchPartyWorkspace\';\nimport { AiVoiceAndConcierge } from \'./components/AiVoiceAndConcierge\';\nimport { OfflineAndSocialWorkspace } from \'./components/OfflineAndSocialWorkspace\';\n\ntype ActiveTab = \'discover\' | \'watch-party\' | \'couple-party\' | \'ai-voice\' | \'offline-social\';\n\nconst PLATFORMS = [\n  \'All Platforms\',\n  \'Nxsha Originals\',\n  \'Netflix\',\n  \'Prime Video\',\n  \'Disney+\',\n  \'Crunchyroll\',\n  \'Max\',\n];\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<ActiveTab>(\'discover\');\n  const [catalog, setCatalog] = useState<MediaItem[]>(INITIAL_CATALOG);\n  const [nxshaSourceLabel, setNxshaSourceLabel] = useState<string>(\'https://nxsha.space\');\n\n  // Theme & Enhanced Night Viewing Mode\n  const [themeMode, setThemeMode] = useState<\'oled-dark\' | \'daylight\'>(\'oled-dark\');\n\n  // Search & Discovery Filters\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [categoryFilter, setCategoryFilter] = useState<\'all\' | \'movie\' | \'tv\' | \'anime\'>(\'all\');\n  const [platformFilter, setPlatformFilter] = useState<string>(\'All Platforms\');\n\n  // Active Media & Inline Theater Modal State\n  const [selectedMedia, setSelectedMedia] = useState<MediaItem>(INITIAL_CATALOG[0]);\n  const [isTheaterOpen, setIsTheaterOpen] = useState<boolean>(false);\n\n  // User Watch History & Likes\n  const [watchHistory, setWatchHistory] = useState<WatchHistoryEntry[]>(INITIAL_WATCH_HISTORY);\n  const [likedIds, setLikedIds] = useState<string[]>([\'nx-204988\', \'nx-969681\']);\n\n  // Offline Vault Downloads (Pre-seeded with 2 ready offline items for immediate verification)\n  const [downloads, setDownloads] = useState<OfflineDownloadItem[]>([\n    {\n      mediaId: \'nx-1400940\',\n      title: \'Clayface\',\n      mediaType: \'movie\',\n      quality: \'1080p FHD\',\n      sizeMB: 1364,\n      downloadedAt: \'Today, 20:15\',\n      streamUrl: \'/api/media/stream/nx-1400940\',\n      blobAvailable: true,\n      progress: 100,\n      status: \'completed\',\n      accentColor: \'#f59e0b\',\n      secondaryColor: \'#0f172a\',\n      year: \'2026\',\n      durationMinutes: 124,\n    },\n    {\n      mediaId: \'nx-204988\',\n      title: \'Velvet Echoes in Kyoto\',\n      mediaType: \'tv\',\n      quality: \'4K UHD\',\n      sizeMB: 1456,\n      downloadedAt: \'Today, 21:05\',\n      streamUrl: \'/api/media/stream/nx-204988\',\n      blobAvailable: true,\n      progress: 100,\n      status: \'completed\',\n      accentColor: \'#ec4899\',\n      secondaryColor: \'#3b0764\',\n      year: \'2026\',\n      durationMinutes: 52,\n    },\n  ]);\n  const [isOfflineSimulated, setIsOfflineSimulated] = useState<boolean>(false);\n\n  // Social Broadcast Posts & Toast Feedback\n  const [socialPosts, setSocialPosts] = useState<SocialBroadcastPost[]>(INITIAL_SOCIAL_POSTS);\n  const [statusBanner, setStatusBanner] = useState<string | null>(null);\n\n  // Security & Privacy Settings\n  const [securitySettings, setSecuritySettings] = useState<SecurityPrivacySettings>({\n    e2eHistoryEncryption: true,\n    incognitoSession: false,\n    drmWatermarkProtection: true,\n    strictCoupleRoomPin: \'7749\',\n    autoClearCacheHours: 24,\n    dnsOverHttpsSource: true,\n  });\n\n  // Push Notifications\n  const [notifications, setNotifications] =\n    useState<PushNotificationItem[]>(INITIAL_NOTIFICATIONS);\n  const [showNotifPopover, setShowNotifPopover] = useState<boolean>(false);\n\n  // Fetch live catalog from /api/nxsha/feed on mount\n  useEffect(() => {\n    let active = true;\n    fetch(\'/api/nxsha/feed?tabKey=home\')\n      .then((r) => r.json())\n      .then((data) => {\n        if (!active) return;\n        if (Array.isArray(data.items) && data.items.length > 0) {\n          setCatalog(data.items);\n          setNxshaSourceLabel(data.source || \'https://nxsha.space/api/home-feed\');\n        }\n      })\n      .catch(() => {\n        // Keep initial deterministic catalog\n      });\n    return () => {\n      active = false;\n    };\n  }, []);\n\n  const triggerBanner = (msg: string) => {\n    setStatusBanner(msg);\n    setTimeout(() => {\n      setStatusBanner((prev) => (prev === msg ? null : prev));\n    }, 3200);\n  };\n\n  // Filtered catalog & Personalized Recommendations\n  const filteredCatalog = useMemo(\n    () =>\n      filterAndSearchCatalog(catalog, searchQuery, categoryFilter, platformFilter, 0),\n    [catalog, searchQuery, categoryFilter, platformFilter]\n  );\n\n  const recommendations = useMemo(\n    () => computePersonalizedRecommendations(catalog, watchHistory, likedIds),\n    [catalog, watchHistory, likedIds]\n  );\n\n  const coupleFavorites = useMemo(\n    () =>\n      [...catalog].sort((a, b) => (b.coupleScore || 85) - (a.coupleScore || 85)).slice(0, 4),\n    [catalog]\n  );\n\n  const handleStartWatching = (item: MediaItem) => {\n    setSelectedMedia(item);\n    setIsTheaterOpen(true);\n\n    if (!securitySettings.incognitoSession) {\n      setWatchHistory((prev) => {\n        const filtered = prev.filter((h) => h.mediaId !== item.id);\n        return [\n          {\n            mediaId: item.id,\n            watchedAt: new Date().toISOString(),\n            progressSeconds: 300,\n            durationSeconds: (item.durationMinutes || 110) * 60,\n            completed: false,\n            genres: item.genres,\n            platform: item.platform,\n          },\n          ...filtered,\n        ];\n      });\n    }\n  };\n\n  const handleDownloadMedia = (item: MediaItem, quality: QualityTier = \'1080p FHD\') => {\n    const sizeMB = estimateOfflineSizeMB(item.durationMinutes, quality);\n    setDownloads((prev) => {\n      const exists = prev.some((d) => d.mediaId === item.id);\n      if (exists) {\n        return prev.map((d) =>\n          d.mediaId === item.id ? { ...d, quality, sizeMB, status: \'completed\', progress: 100 } : d\n        );\n      }\n      return [\n        {\n          mediaId: item.id,\n          title: item.title,\n          mediaType: item.mediaType,\n          quality,\n          sizeMB,\n          downloadedAt: \'Just now\',\n          streamUrl: item.streamUrl,\n          blobAvailable: true,\n          progress: 100,\n          status: \'completed\',\n          accentColor: item.accentColor,\n          secondaryColor: item.secondaryColor,\n          year: item.year,\n          durationMinutes: item.durationMinutes,\n        },\n        ...prev,\n      ];\n    });\n    triggerBanner(`Downloaded \"${item.title}\" (${quality} \302\267 ${sizeMB} MB) to Offline Vault.`);\n  };\n\n  const handleRemoveDownload = (mediaId: string) => {\n    setDownloads((prev) => prev.filter((d) => d.mediaId !== mediaId));\n    triggerBanner(\'Removed title from Offline Vault.\');\n  };\n\n  const handleQuickShare = (item: MediaItem, timestampFormatted: string) => {\n    const newPost: SocialBroadcastPost = {\n      id: `post-${Date.now()}`,\n      authorName: \'Alex Rivera\',\n      authorHandle: \'@alex_nxsha\',\n      mediaId: item.id,\n      mediaTitle: item.title,\n      ClipTimestamp: timestampFormatted,\n      caption: `Watching ${item.title} at ${timestampFormatted} in 4K ABR on Nxsha Stream! Join my Watch Party.`,\n      platformTarget: \'Community Feed\',\n      likes: 1,\n      createdAt: \'Just now\',\n    };\n    setSocialPosts((prev) => [newPost, ...prev]);\n    triggerBanner(`Broadcasted \"${item.title}\" clip (@${timestampFormatted}) to Community Feed.`);\n  };\n\n  const handleToggleLike = (mediaId: string) => {\n    setLikedIds((prev) =>\n      prev.includes(mediaId) ? prev.filter((id) => id !== mediaId) : [...prev, mediaId]\n    );\n  };\n\n  const unreadNotifCount = notifications.filter((n) => !n.read).length;\n\n  const isDark = themeMode === \'oled-dark\';\n\n  return (\n    <div\n      className={`min-h-screen transition-colors pb-20 md:pb-12 ${\n        isDark\n          ? \'bg-slate-950 text-slate-100\'\n          : \'bg-[#0b1120] text-slate-100 sepia-[0.08]\'\n      }`}\n    >\n      {/* Top Bar Contract: Strictly 1-Row, 3-Zone Header */}\n      <header\n        className={`sticky top-0 z-40 flex items-center justify-between gap-8 px-6 py-4 border-b backdrop-blur-md ${\n          isDark\n            ? \'bg-slate-950/90 border-slate-800 text-slate-100\'\n            : \'bg-[#0b1120]/95 border-amber-500/20 text-slate-100\'\n        }`}\n      >\n        {/* Zone 1: Single text element wordmark */}\n        <a\n          href=\"#discover\"\n          onClick={(e) => {\n            e.preventDefault();\n            setActiveTab(\'discover\');\n          }}\n          className=\"text-xl font-display font-bold tracking-tight text-amber-400 whitespace-nowrap shrink-0\"\n        >\n          Nxsha Stream\n        </a>\n\n        {/* Zone 2: 5 clean single-line text navigation links */}\n        <nav\n          aria-label=\"Primary Workspace Navigation\"\n          className=\"hidden md:flex items-center gap-6 text-sm font-medium\"\n        >\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'discover\')}\n            className={`transition-colors whitespace-nowrap shrink-0 pb-0.5 ${\n              activeTab === \'discover\'\n                ? \'text-amber-400 border-b-2 border-amber-400 font-semibold\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            Discover\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'watch-party\')}\n            className={`transition-colors whitespace-nowrap shrink-0 pb-0.5 ${\n              activeTab === \'watch-party\'\n                ? \'text-amber-400 border-b-2 border-amber-400 font-semibold\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            Watch Party\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'couple-party\')}\n            className={`transition-colors whitespace-nowrap shrink-0 pb-0.5 ${\n              activeTab === \'couple-party\'\n                ? \'text-pink-400 border-b-2 border-pink-400 font-semibold\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            Couple Lounge\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'ai-voice\')}\n            className={`transition-colors whitespace-nowrap shrink-0 pb-0.5 ${\n              activeTab === \'ai-voice\'\n                ? \'text-amber-400 border-b-2 border-amber-400 font-semibold\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            AI & Voice\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'offline-social\')}\n            className={`transition-colors whitespace-nowrap shrink-0 pb-0.5 ${\n              activeTab === \'offline-social\'\n                ? \'text-amber-400 border-b-2 border-amber-400 font-semibold\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            Offline & Social\n          </button>\n        </nav>\n\n        {/* Zone 3: 1 primary action button */}\n        <div className=\"flex items-center shrink-0\">\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'couple-party\')}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-950 bg-amber-500 hover:bg-amber-400 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n          >\n            Start Couple Party\n          </button>\n        </div>\n      </header>\n\n      {/* Secondary Workspace Control Bar (Search, Night Mode, Push Alerts, Security Indicator) */}\n      <div\n        className={`border-b px-6 py-3 ${\n          isDark ? \'bg-slate-900/70 border-slate-800/80\' : \'bg-slate-100 border-slate-200\'\n        }`}\n      >\n        <div className=\"max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4\">\n          {/* Comprehensive Search Bar */}\n          <div className=\"relative flex-1 min-w-[240px] max-w-md\">\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n            <label htmlFor=\"global-catalog-search\" className=\"sr-only\">\n              Search movies, series, anime, directors, or genres\n            </label>\n            <input\n              id=\"global-catalog-search\"\n              type=\"search\"\n              placeholder=\"Search titles, genres, directors, or nxsha.space catalog...\"\n              value={searchQuery}\n              onChange={(e) => {\n                setSearchQuery(e.target.value);\n                if (activeTab !== \'discover\') setActiveTab(\'discover\');\n              }}\n              className={`w-full pl-9 pr-3 py-1.5 text-xs rounded-lg border focus:outline-none focus:border-amber-500 ${\n                isDark\n                  ? \'bg-slate-950 border-slate-800 text-slate-100 placeholder:text-slate-500\'\n                  : \'bg-white border-slate-300 text-slate-900 placeholder:text-slate-400\'\n              }`}\n            />\n          </div>\n\n          {/* Right Workspace Utility Controls */}\n          <div className=\"flex items-center gap-2.5 flex-wrap\">\n            <span className=\"hidden lg:inline-block text-xs font-mono text-slate-400\">\n              Source: {nxshaSourceLabel}\n            </span>\n\n            {/* Enhanced Night Viewing / Dark Mode Toggle */}\n            <button\n              type=\"button\"\n              onClick={() =>\n                setThemeMode((prev) => (prev === \'oled-dark\' ? \'daylight\' : \'oled-dark\'))\n              }\n              aria-label=\"Toggle Dark Mode for Enhanced Night Viewing\"\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-800 bg-slate-950 text-slate-200 hover:border-slate-700 transition-colors whitespace-nowrap shrink-0\"\n            >\n              {isDark ? (\n                <>\n                  <Moon className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span>OLED Night Mode</span>\n                </>\n              ) : (\n                <>\n                  <Sun className=\"w-3.5 h-3.5 text-amber-500\" />\n                  <span>Daylight Mode</span>\n                </>\n              )}\n            </button>\n\n            {/* Push Notifications Trigger */}\n            <div className=\"relative\">\n              <button\n                type=\"button\"\n                onClick={() => setShowNotifPopover(!showNotifPopover)}\n                aria-label={`Push Notifications (${unreadNotifCount} unread)`}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-800 bg-slate-950 text-slate-200 hover:border-slate-700 transition-colors whitespace-nowrap shrink-0\"\n              >\n                <Bell className=\"w-3.5 h-3.5 text-amber-400\" />\n                <span className=\"font-mono tabular-nums\">Alerts ({unreadNotifCount})</span>\n              </button>\n\n              {showNotifPopover && (\n                <div className=\"absolute right-0 mt-2 w-80 p-4 rounded-xl bg-slate-900 border border-slate-800 shadow-xl z-50 space-y-2.5\">\n                  <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n                    <span className=\"text-xs font-semibold text-white\">\n                      Episode & Trending Push Alerts\n                    </span>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setNotifications((prev) => prev.map((n) => ({ ...n, read: true })));\n                      }}\n                      className=\"text-[11px] text-amber-400 hover:underline\"\n                    >\n                      Mark All Read\n                    </button>\n                  </div>\n                  {notifications.map((n) => (\n                    <div\n                      key={n.id}\n                      className=\"p-2.5 rounded-lg bg-slate-950 border border-slate-800 text-xs space-y-1\"\n                    >\n                      <div className=\"flex items-center justify-between font-medium text-white\">\n                        <span>{n.title}</span>\n                        <span className=\"text-[10px] font-mono text-slate-400\">{n.createdAt}</span>\n                      </div>\n                      <p className=\"text-[11px] text-slate-400\">{n.body}</p>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Security Status Shortcut */}\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'offline-social\')}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-800 bg-slate-950 text-emerald-400 hover:border-slate-700 transition-colors whitespace-nowrap shrink-0\"\n            >\n              <ShieldCheck className=\"w-3.5 h-3.5\" />\n              <span>E2EE Protected</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Transient Confirmation Banner */}\n      {statusBanner && (\n        <div\n          role=\"status\"\n          className=\"bg-amber-500 text-slate-950 px-6 py-2 text-xs font-semibold text-center flex items-center justify-center gap-2\"\n        >\n          <Check className=\"w-4 h-4\" />\n          <span>{statusBanner}</span>\n        </div>\n      )}\n\n      {/* Main Content Container */}\n      <main className=\"max-w-7xl mx-auto px-6 py-8 space-y-10\">\n        {/* Inline Adaptive Video Player Modal/Drawer when user clicks Watch Now */}\n        {isTheaterOpen && activeTab === \'discover\' && (\n          <section aria-label=\"Active Cinema Theater\" className=\"space-y-4\">\n            <AdaptiveVideoPlayer\n              item={selectedMedia}\n              isOfflineMode={isOfflineSimulated}\n              onTriggerDownload={handleDownloadMedia}\n              onTriggerShare={handleQuickShare}\n              onClose={() => setIsTheaterOpen(false)}\n            />\n          </section>\n        )}\n\n        {/* TAB 1: DISCOVER (All-Streaming Aggregator + Nxsha.space Feed + Personalized Engine) */}\n        {activeTab === \'discover\' && (\n          <div className=\"space-y-12\">\n            {/* Featured Hero Spotlight (2-Column Balanced Split on Desktop) */}\n            {!isTheaterOpen && (\n              <section\n                aria-label=\"Featured Release Spotlight\"\n                className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden\"\n              >\n                <div className=\"lg:col-span-7 p-6 sm:p-8 flex flex-col justify-between space-y-6\">\n                  <div className=\"space-y-4\">\n                    {/* Clean unboxed metadata line (Zero-Pill Discipline) */}\n                    <div className=\"flex flex-wrap items-center gap-2 text-xs text-amber-400 font-mono tabular-nums\">\n                      <span>{selectedMedia.platform}</span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>{selectedMedia.releaseDate}</span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>\342\230\205 {selectedMedia.rating.toFixed(1)}</span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>4K UHD AV1 ABR</span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>Couple Score {selectedMedia.coupleScore || 92}%</span>\n                    </div>\n\n                    <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-tight\">\n                      {selectedMedia.title}\n                    </h1>\n\n                    <p className=\"text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl\">\n                      {selectedMedia.description}\n                    </p>\n\n                    <div className=\"text-xs text-slate-400\">\n                      <span>Directed by {selectedMedia.director}</span>\n                      <span className=\"mx-2\" aria-hidden=\"true\">\n                        \302\267\n                      </span>\n                      <span>Starring {selectedMedia.cast.join(\', \')}</span>\n                      <span className=\"mx-2\" aria-hidden=\"true\">\n                        \302\267\n                      </span>\n                      <span>Genres: {selectedMedia.genres.join(\' / \')}</span>\n                    </div>\n                  </div>\n\n                  {/* Hero Action Bar */}\n                  <div className=\"flex flex-wrap items-center gap-3 pt-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => handleStartWatching(selectedMedia)}\n                      className=\"inline-flex items-center gap-2 px-5 py-2.5 text-xs sm:text-sm font-semibold bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                    >\n                      <Play className=\"w-4 h-4 fill-current\" />\n                      <span>Watch Now (4K ABR)</span>\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => setActiveTab(\'couple-party\')}\n                      className=\"inline-flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-semibold bg-pink-600 hover:bg-pink-500 text-white rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                    >\n                      <Heart className=\"w-4 h-4 fill-current\" />\n                      <span>Couple Watch Party</span>\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => setActiveTab(\'watch-party\')}\n                      className=\"inline-flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-medium bg-slate-800 hover:bg-slate-700 text-slate-100 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                    >\n                      <Users className=\"w-4 h-4\" />\n                      <span>Group Watch Party</span>\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => handleDownloadMedia(selectedMedia, \'1080p FHD\')}\n                      className=\"inline-flex items-center gap-1.5 px-3.5 py-2.5 text-xs font-medium bg-slate-950 hover:bg-slate-800 text-slate-200 border border-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                    >\n                      <Download className=\"w-4 h-4\" />\n                      <span>Offline Vault</span>\n                    </button>\n\n                    <a\n                      href={selectedMedia.nxshaWatchUrl}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"inline-flex items-center gap-1.5 px-3.5 py-2.5 text-xs font-medium bg-slate-950 hover:bg-slate-800 text-slate-300 border border-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                    >\n                      <span>nxsha.space</span>\n                      <ExternalLink className=\"w-3.5 h-3.5\" />\n                    </a>\n                  </div>\n                </div>\n\n                <div className=\"lg:col-span-5 relative min-h-[260px] lg:min-h-full\">\n                  <MediaPoster\n                    item={selectedMedia}\n                    variant=\"backdrop\"\n                    className=\"w-full h-full object-cover\"\n                  />\n                </div>\n              </section>\n            )}\n\n            {/* Interactive Category & Streaming Platform Aggregator Filter Bar */}\n            <section aria-label=\"Catalog Filter Controls\" className=\"space-y-4\">\n              <div className=\"flex flex-wrap items-center justify-between gap-4\">\n                {/* Media Type Segmented Control */}\n                <div\n                  className=\"flex items-center gap-1 p-1 bg-slate-900 border border-slate-800 rounded-lg\"\n                  role=\"group\"\n                  aria-label=\"Filter by Media Category\"\n                >\n                  {(\n                    [\n                      { id: \'all\', label: \'All Titles\' },\n                      { id: \'movie\', label: \'Movies\' },\n                      { id: \'tv\', label: \'TV Series\' },\n                      { id: \'anime\', label: \'Anime\' },\n                    ] as const\n                  ).map((cat) => (\n                    <button\n                      key={cat.id}\n                      type=\"button\"\n                      onClick={() => setCategoryFilter(cat.id)}\n                      className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                        categoryFilter === cat.id\n                          ? \'bg-amber-500 text-slate-950 font-semibold\'\n                          : \'text-slate-400 hover:text-white\'\n                      }`}\n                    >\n                      {cat.label}\n                    </button>\n                  ))}\n                </div>\n\n                {/* Streaming Service Origin Filter */}\n                <div\n                  className=\"flex items-center gap-1.5 overflow-x-auto pb-1\"\n                  role=\"group\"\n                  aria-label=\"Filter by Streaming Service\"\n                >\n                  {PLATFORMS.map((plat) => (\n                    <button\n                      key={plat}\n                      type=\"button\"\n                      onClick={() => setPlatformFilter(plat)}\n                      className={`px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors whitespace-nowrap shrink-0 ${\n                        platformFilter === plat\n                          ? \'bg-slate-100 text-slate-950 border-white font-semibold\'\n                          : \'bg-slate-900 text-slate-400 border-slate-800 hover:text-white\'\n                      }`}\n                    >\n                      {plat}\n                    </button>\n                  ))}\n                </div>\n              </div>\n            </section>\n\n            {/* Row 1: Unified Catalog & Search Results */}\n            <section aria-label=\"Nxsha Catalog Feed\" className=\"space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <h2 className=\"text-xl font-display font-bold text-white\">\n                    01. Unified Streaming Catalog (Sourced from nxsha.space)\n                  </h2>\n                  <p className=\"text-xs text-slate-400\">\n                    Showing {filteredCatalog.length} titles \302\267 Adaptive Bitrate 4K/1080p ready \302\267\n                    Instant Watch Party & Offline support\n                  </p>\n                </div>\n                {searchQuery && (\n                  <button\n                    type=\"button\"\n                    onClick={() => setSearchQuery(\'\')}\n                    className=\"text-xs text-amber-400 hover:underline\"\n                  >\n                    Clear Search ({searchQuery})\n                  </button>\n                )}\n              </div>\n\n              {filteredCatalog.length === 0 ? (\n                <div className=\"p-10 text-center bg-slate-900 border border-slate-800 rounded-xl space-y-3\">\n                  <p className=\"text-sm font-medium text-slate-200\">\n                    No titles matched &ldquo;{searchQuery}&rdquo; in {platformFilter}.\n                  </p>\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setSearchQuery(\'\');\n                      setCategoryFilter(\'all\');\n                      setPlatformFilter(\'All Platforms\');\n                    }}\n                    className=\"px-4 py-2 text-xs font-semibold bg-amber-500 text-slate-950 rounded-lg\"\n                  >\n                    Reset Catalog Filters\n                  </button>\n                </div>\n              ) : (\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n                  {filteredCatalog.map((item) => {\n                    const isDownloaded = downloads.some((d) => d.mediaId === item.id);\n                    const isLiked = likedIds.includes(item.id);\n                    return (\n                      <article\n                        key={item.id}\n                        className=\"bg-slate-900 border border-slate-800 rounded-xl overflow-hidden flex flex-col justify-between transition-transform hover:-translate-y-0.5\"\n                      >\n                        <div>\n                          <div className=\"relative aspect-[3/4] w-full overflow-hidden\">\n                            <MediaPoster item={item} variant=\"poster\" className=\"w-full h-full\" />\n                          </div>\n\n                          <div className=\"p-4 space-y-2\">\n                            {/* Unboxed static metadata line */}\n                            <div className=\"flex items-center gap-1.5 text-xs text-slate-400 font-mono tabular-nums\">\n                              <span>{item.platform}</span>\n                              <span aria-hidden=\"true\">\302\267</span>\n                              <span>{item.year}</span>\n                              <span aria-hidden=\"true\">\302\267</span>\n                              <span className=\"text-amber-400\">\342\230\205 {item.rating.toFixed(1)}</span>\n                            </div>\n\n                            <h3 className=\"text-base font-display font-bold text-white leading-snug\">\n                              {item.title}\n                            </h3>\n\n                            <div className=\"text-xs text-slate-400\">\n                              {item.genres.join(\' \302\267 \')} \302\267 {item.durationMinutes}m\n                            </div>\n\n                            <p className=\"text-xs text-slate-400 line-clamp-2 leading-relaxed\">\n                              {item.description}\n                            </p>\n                          </div>\n                        </div>\n\n                        <div className=\"p-4 pt-0 space-y-2\">\n                          <div className=\"flex items-center gap-2\">\n                            <button\n                              type=\"button\"\n                              onClick={() => handleStartWatching(item)}\n                              className=\"flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 text-xs font-semibold bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-lg transition-colors whitespace-nowrap\"\n                            >\n                              <Play className=\"w-3.5 h-3.5 fill-current\" />\n                              <span>Stream</span>\n                            </button>\n\n                            <button\n                              type=\"button\"\n                              onClick={() => {\n                                setSelectedMedia(item);\n                                setActiveTab(\'couple-party\');\n                              }}\n                              aria-label={`Start Couple Watch Party for ${item.title}`}\n                              className=\"p-2 bg-slate-800 hover:bg-pink-600 text-slate-200 hover:text-white rounded-lg transition-colors\"\n                            >\n                              <Heart className=\"w-3.5 h-3.5\" />\n                            </button>\n\n                            <button\n                              type=\"button\"\n                              onClick={() => handleDownloadMedia(item, \'1080p FHD\')}\n                              aria-label={`Download ${item.title} for offline viewing`}\n                              className={`p-2 rounded-lg transition-colors ${\n                                isDownloaded\n                                  ? \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40\'\n                                  : \'bg-slate-800 hover:bg-slate-700 text-slate-200\'\n                              }`}\n                            >\n                              {isDownloaded ? (\n                                <Check className=\"w-3.5 h-3.5\" />\n                              ) : (\n                                <Download className=\"w-3.5 h-3.5\" />\n                              )}\n                            </button>\n\n                            <button\n                              type=\"button\"\n                              onClick={() => handleQuickShare(item, \'14:20\')}\n                              aria-label={`Share ${item.title} to social feed`}\n                              className=\"p-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg transition-colors\"\n                            >\n                              <Share2 className=\"w-3.5 h-3.5\" />\n                            </button>\n                          </div>\n\n                          <div className=\"flex items-center justify-between text-[11px] text-slate-400 pt-1\">\n                            <button\n                              type=\"button\"\n                              onClick={() => handleToggleLike(item.id)}\n                              className=\"hover:text-amber-400 transition-colors\"\n                            >\n                              {isLiked ? \'\342\230\205 In Favorites\' : \'+ Add to Favorites\'}\n                            </button>\n                            <a\n                              href={item.nxshaWatchUrl}\n                              target=\"_blank\"\n                              rel=\"noopener noreferrer\"\n                              className=\"font-mono hover:text-white inline-flex items-center gap-1\"\n                            >\n                              <span>nxsha.space</span>\n                              <ExternalLink className=\"w-3 h-3\" />\n                            </a>\n                          </div>\n                        </div>\n                      </article>\n                    );\n                  })}\n                </div>\n              )}\n            </section>\n\n            {/* Row 2: Personalized Recommendation Engine Based on User Viewing History */}\n            <section aria-label=\"Personalized Recommendations\" className=\"space-y-4\">\n              <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                <div>\n                  <h2 className=\"text-xl font-display font-bold text-white\">\n                    02. Personalized Recommendations (Driven by Your Viewing History)\n                  </h2>\n                  <p className=\"text-xs text-slate-400\">\n                    Computed from your watch history ({watchHistory.length} tracked sessions) and\n                    genre affinity weights\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveTab(\'ai-voice\')}\n                  className=\"inline-flex items-center gap-1.5 text-xs font-semibold text-amber-400 hover:underline\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  <span>Open Gemini High-Thinking Analyst</span>\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                {recommendations.slice(0, 4).map((rec) => (\n                  <div\n                    key={rec.item.id}\n                    className=\"p-4 rounded-xl bg-slate-900 border border-slate-800 flex flex-col justify-between space-y-3\"\n                  >\n                    <div className=\"space-y-1.5\">\n                      <div className=\"text-xs font-mono text-amber-400 tabular-nums\">\n                        {rec.reason}\n                      </div>\n                      <h3 className=\"text-base font-display font-bold text-white\">\n                        {rec.item.title}\n                      </h3>\n                      <div className=\"text-xs text-slate-400 font-mono\">\n                        {rec.item.platform} \302\267 {rec.item.year} \302\267 \342\230\205 {rec.item.rating}\n                      </div>\n                      <p className=\"text-xs text-slate-400 line-clamp-2\">{rec.item.description}</p>\n                    </div>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleStartWatching(rec.item)}\n                      className=\"w-full py-2 px-3 text-xs font-semibold bg-slate-800 hover:bg-amber-500 hover:text-slate-950 text-slate-100 rounded-lg transition-colors\"\n                    >\n                      Play Recommended Stream\n                    </button>\n                  </div>\n                ))}\n              </div>\n            </section>\n\n            {/* Row 3: Couple Watch Party Curated Highlights */}\n            <section aria-label=\"Couple Watch Party Picks\" className=\"space-y-4\">\n              <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                <div>\n                  <h2 className=\"text-xl font-display font-bold text-white\">\n                    03. Couple Watch Party Lounge Picks (2-Seat Synchronized Cinema)\n                  </h2>\n                  <p className=\"text-xs text-slate-400\">\n                    Highest couple affinity scores with private E2EE dual-seat sync and shared\n                    heartbeat reactions\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveTab(\'couple-party\')}\n                  className=\"text-xs font-semibold text-pink-400 hover:underline\"\n                >\n                  Enter Couple Lounge \342\206\222\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n                {coupleFavorites.map((item) => (\n                  <div\n                    key={item.id}\n                    className=\"p-4 rounded-xl bg-slate-900 border border-slate-800 flex flex-col justify-between space-y-3\"\n                  >\n                    <div className=\"space-y-1.5\">\n                      <div className=\"text-xs font-mono text-pink-400 tabular-nums\">\n                        {item.coupleScore}% Couple Sync Affinity \302\267 {item.genres[0]}\n                      </div>\n                      <h3 className=\"text-base font-display font-bold text-white\">{item.title}</h3>\n                      <p className=\"text-xs text-slate-400 line-clamp-2\">{item.description}</p>\n                    </div>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setSelectedMedia(item);\n                        setActiveTab(\'couple-party\');\n                      }}\n                      className=\"w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 text-xs font-semibold bg-pink-600 hover:bg-pink-500 text-white rounded-lg transition-colors whitespace-nowrap\"\n                    >\n                      <Heart className=\"w-3.5 h-3.5 fill-current\" />\n                      <span>Launch Couple Watch Party</span>\n                    </button>\n                  </div>\n                ))}\n              </div>\n            </section>\n          </div>\n        )}\n\n        {/* TAB 2 & TAB 3: WATCH PARTY (Group Mode or Couple Mode) */}\n        {(activeTab === \'watch-party\' || activeTab === \'couple-party\') && (\n          <WatchPartyWorkspace\n            catalog={catalog}\n            selectedMedia={selectedMedia}\n            initialMode={activeTab === \'couple-party\' ? \'couple\' : \'group\'}\n            onSelectMedia={(item) => setSelectedMedia(item)}\n            onTriggerDownload={handleDownloadMedia}\n            onTriggerShare={handleQuickShare}\n          />\n        )}\n\n        {/* TAB 4: GEMINI AI INTELLIGENCE, HIGH THINKING & LIVE VOICE CONVERSATION */}\n        {activeTab === \'ai-voice\' && (\n          <AiVoiceAndConcierge\n            catalog={catalog}\n            history={watchHistory}\n            recommendations={recommendations}\n            selectedMedia={selectedMedia}\n            onSelectMediaAndPlay={(item) => {\n              setSelectedMedia(item);\n              setActiveTab(\'discover\');\n              setIsTheaterOpen(true);\n            }}\n          />\n        )}\n\n        {/* TAB 5: OFFLINE VAULT, SOCIAL BROADCAST & SECURITY PRIVACY */}\n        {activeTab === \'offline-social\' && (\n          <OfflineAndSocialWorkspace\n            catalog={catalog}\n            downloads={downloads}\n            isOfflineSimulated={isOfflineSimulated}\n            onToggleOfflineSimulation={() => setIsOfflineSimulated(!isOfflineSimulated)}\n            onDownloadMedia={handleDownloadMedia}\n            onRemoveDownload={handleRemoveDownload}\n            onPlayDownloaded={(mediaId) => {\n              const found = catalog.find((c) => c.id === mediaId) || catalog[0];\n              setSelectedMedia(found);\n              setActiveTab(\'discover\');\n              setIsTheaterOpen(true);\n            }}\n            socialPosts={socialPosts}\n            onCreateSocialPost={(post) => {\n              setSocialPosts((prev) => [\n                {\n                  ...post,\n                  id: `post-${Date.now()}`,\n                  likes: 1,\n                  createdAt: \'Just now\',\n                },\n                ...prev,\n              ]);\n              triggerBanner(`Shared \"${post.mediaTitle}\" clip to ${post.platformTarget}.`);\n            }}\n            onLikeSocialPost={(postId) => {\n              setSocialPosts((prev) =>\n                prev.map((p) => (p.id === postId ? { ...p, likes: p.likes + 1 } : p))\n              );\n            }}\n            securitySettings={securitySettings}\n            onUpdateSecurity={setSecuritySettings}\n            notifications={notifications}\n            onMarkAllNotificationsRead={() =>\n              setNotifications((prev) => prev.map((n) => ({ ...n, read: true })))\n            }\n          />\n        )}\n      </main>\n\n      {/* Clean Editorial Footer */}\n      <footer className=\"max-w-7xl mx-auto px-6 py-8 border-t border-slate-800/80 text-xs text-slate-400 flex flex-wrap items-center justify-between gap-4\">\n        <div>\n          Nxsha Stream \302\267 Cross-Platform Adaptive Bitrate Cinema & Watch Party Suite \302\267 Sources powered\n          by{\' \'}\n          <a\n            href=\"https://nxsha.space\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"text-amber-400 hover:underline font-mono\"\n          >\n            https://nxsha.space\n          </a>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'offline-social\')}\n            className=\"hover:text-white\"\n          >\n            Offline Vault ({downloads.length})\n          </button>\n          <span>\302\267</span>\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'couple-party\')}\n            className=\"hover:text-white\"\n          >\n            Couple Watch Party\n          </button>\n          <span>\302\267</span>\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'ai-voice\')}\n            className=\"hover:text-white\"\n          >\n            Gemini 4 Argon & Live Voice\n          </button>\n        </div>\n      </footer>\n\n      {/* Mobile Ergonomic Bottom Navigation Bar (<768px) */}\n      <nav\n        aria-label=\"Mobile Bottom Navigation\"\n        className=\"md:hidden fixed bottom-0 left-0 right-0 z-40 bg-slate-950/95 backdrop-blur-md border-t border-slate-800 grid grid-cols-5 items-center h-14 px-1\"\n      >\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'discover\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center text-[10px] font-medium ${\n            activeTab === \'discover\' ? \'text-amber-400\' : \'text-slate-400\'\n          }`}\n        >\n          <Compass className=\"w-4 h-4 mb-0.5\" />\n          <span>Discover</span>\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'watch-party\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center text-[10px] font-medium ${\n            activeTab === \'watch-party\' ? \'text-amber-400\' : \'text-slate-400\'\n          }`}\n        >\n          <Users className=\"w-4 h-4 mb-0.5\" />\n          <span>Party</span>\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'couple-party\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center text-[10px] font-medium ${\n            activeTab === \'couple-party\' ? \'text-pink-400\' : \'text-slate-400\'\n          }`}\n        >\n          <Heart className=\"w-4 h-4 mb-0.5\" />\n          <span>Couple</span>\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'ai-voice\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center text-[10px] font-medium ${\n            activeTab === \'ai-voice\' ? \'text-amber-400\' : \'text-slate-400\'\n          }`}\n        >\n          <Sparkles className=\"w-4 h-4 mb-0.5\" />\n          <span>AI Voice</span>\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'offline-social\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center text-[10px] font-medium ${\n            activeTab === \'offline-social\' ? \'text-amber-400\' : \'text-slate-400\'\n          }`}\n        >\n          <HardDrive className=\"w-4 h-4 mb-0.5\" />\n          <span>Vault</span>\n        </button>\n      </nav>\n    </div>\n  );\n}\n"
    num_lines: 1100
    num_bytes: 46016
    line_range_bytes: 46016
  }
}
