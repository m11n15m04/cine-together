# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL. DATABASE_URL is preferred; legacy split SQL_* values remain supported.
DATABASE_URL=
POSTGRES_URL=
DATABASE_SSL=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
SQL_HOST=
SQL_PORT=5432
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Required in production for signed guest sessions and room access tickets (32+ random bytes).
AUTH_TOKEN_SECRET=

# Firebase client configuration (public Firebase web config, injected at build time).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional AI credential. No catalog provider credential is configured until Nxsha publishes an authorized API contract.
GEMINI_API_KEY=

# Optional JSON object keyed by canonical media ID. Each value is {"type":"mp4"|"hls","url":"https://..."}.
# Configure only sources for which CineTogether has explicit playback rights.
AUTHORIZED_MEDIA_SOURCES_JSON={}
AUTHORIZED_MEDIA_HOSTS=

# Frontend display settings (not credentials).
VITE_APP_NAME=CineTogether
